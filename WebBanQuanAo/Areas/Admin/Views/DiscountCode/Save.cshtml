@model Data.Entity.DiscountCodeEntity

<section class="content-header">
    <h1>
        @(Model.Id > 0 ? "Sửa mã giảm giá" : "Thêm mã giảm giá")
    </h1>
</section>

<section class="content">
    <div class="row">
        <div class="col-md-6">
            <div class="box box-primary">

                <form asp-area="Admin"
                      asp-controller="DiscountCode"
                      asp-action="Save"
                      method="post">

                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="box-body">

                        <div class="form-group">
                            <label>Mã giảm giá</label>
                            <input type="text"
                                   name="Code"
                                   value="@Model.Code"
                                   class="form-control"
                                   placeholder="VD: VYBE10"
                                   required />
                        </div>

                        <div class="form-group">
                            <label>Tên chương trình</label>
                            <input type="text"
                                   name="Name"
                                   value="@Model.Name"
                                   class="form-control"
                                   placeholder="Nhập tên"
                                   required />
                        </div>

                        <div class="form-group">
                            <label>Loại giảm giá</label>
                            <select name="DiscountType" class="form-control">
                                @if (Model.DiscountType == 1)
                                {
                                    <option value="1" selected>Theo %</option>
                                    <option value="2">Theo tiền</option>
                                }
                                else
                                {
                                    <option value="1">Theo %</option>
                                    <option value="2" selected>Theo tiền</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Giá trị giảm</label>
                            @if (Model.DiscountType == 1)
                            {
                                <input type="number"
                                       name="DiscountValue"
                                       value="@Model.DiscountValue.ToString("N0")"
                                       class="form-control"
                                       min="0"
                                       placeholder="Nhập giá trị giảm"
                                       required />
                            }
                            else
                            {
                                <input type="number"
                                       name="DiscountValue"
                                       value="@Model.DiscountValue.ToString("N0")"
                                       class="form-control"
                                       min="0"
                                       placeholder="Nhập giá trị giảm"
                                       required />
                            }
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Đơn tối thiểu</label>
                                    <input type="number"
                                           name="MinOrderValue"
                                           value="@Model.MinOrderValue?.ToString("N0")"
                                           class="form-control"
                                           min="0"
                                           placeholder="VD: 200000" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Giảm tối đa</label>
                                    <input type="number"
                                           name="MaxDiscount"
                                           value="@Model.MaxDiscount?.ToString("N0")"
                                           class="form-control"
                                           min="0"
                                           placeholder="VD: 100000" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Số lượt sử dụng</label>
                            <input type="number"
                                   name="Quantity"
                                   value="@Model.Quantity"
                                   class="form-control"
                                   min="1"
                                   required />
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Ngày bắt đầu</label>
                                    <input type="date"
                                           name="StartDate"
                                           value="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                                           class="form-control" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Ngày kết thúc</label>
                                    <input type="date"
                                           name="EndDate"
                                           value="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                                           class="form-control" />
                                </div>
                            </div>
                        </div>

                        @if (Model.Id > 0)
                        {
                            <div class="form-group">
                                <label>
                                    <input type="checkbox"
                                           name="IsActive"
                                           value="true"
                                           @(Model.IsActive ? "checked" : "") />
                                    Đang hoạt động
                                </label>
                            </div>
                        }

                    </div>

                    <div class="box-footer">
                        <button type="submit" class="btn btn-primary">
                            Lưu
                        </button>

                        <a href="/Admin/DiscountCode/Index" class="btn btn-default">
                            Quay lại
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</section>