@using Data.DTO.Common
@using Data.Entity.Enums
@model PagedResult<Data.DTO.Order.OrderAdminDTO>

@{
    ViewData["Title"] = "Quản lý đơn hàng";

    var currentStatus = Context.Request.Query["status"].ToString();

    // Map thẳng trạng thái sang class màu Soft UI
    string GetStatusStyle(int statusId)
    {
        return statusId switch
        {
            0 => "badge-soft-primary",   // Mới
            1 => "badge-soft-info",      // Đã xác nhận / Đang chuẩn bị
            2 => "badge-soft-warning",   // Đang giao
            3 => "badge-soft-success",   // Hoàn thành
            4 => "badge-soft-danger",    // Đã hủy
            _ => "badge-soft-secondary"  // Mặc định
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/orderadmin.css" />
}
<div class="container-fluid py-4">

    <div class="modern-card">
        <div class="modern-card-header" style="flex-direction: column; align-items: flex-start; gap: 5px;">
            <h4 class="modern-card-title">
                <i class="fas fa-shopping-cart text-primary"></i> Quản lý đơn hàng
            </h4>
            <p class="modern-card-subtitle">Theo dõi và xử lý các đơn đặt hàng từ khách hàng.</p>
        </div>

        <div class="modern-toolbar">
            <form method="get" class="toolbar-row" style="margin-bottom: 0;">
                <div class="filter-group">

                    <select name="status" class="modern-control" style="min-width: 160px;">
                        <option value="">-- Tất cả trạng thái --</option>
                        @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                        {
                            <option value="@((int)s)" selected="@(currentStatus == ((int)s).ToString())">
                                @s
                            </option>
                        }
                    </select>

                    <div class="search-wrapper">
                        <i class="fas fa-search"></i>
                        <input type="text"
                               name="keyword"
                               value="@Context.Request.Query["keyword"]"
                               class="modern-control"
                               placeholder="Tìm theo tên khách, SĐT..." />
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px;">
                        <input type="date"
                               name="fromDate"
                               value="@Context.Request.Query["fromDate"]"
                               class="modern-control"
                               title="Từ ngày" />
                        <span style="color: #94a3b8;"><i class="fas fa-minus"></i></span>
                        <input type="date"
                               name="toDate"
                               value="@Context.Request.Query["toDate"]"
                               class="modern-control"
                               title="Đến ngày" />
                    </div>

                    <button type="submit" class="btn-modern-primary">
                        <i class="fas fa-filter" style="margin-right: 5px;"></i> Lọc kết quả
                    </button>

                    <a href="?" class="btn-modern btn-outline-secondary-modern">
                        Xóa bộ lọc
                    </a>

                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th class="text-center" width="100">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Liên lạc</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-center" width="120">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var o in Model.Items)
                        {
                            <tr>
                                <td class="text-center order-id-text">#@o.Id</td>

                                <td class="fw-bold text-dark">
                                    @(string.IsNullOrEmpty(o.FullName) ? "Khách vãng lai" : o.FullName)
                                </td>

                                <td>
                                    <span style="color: #475569;"><i class="fas fa-phone-alt" style="font-size: 0.8em; margin-right: 4px; color: #94a3b8;"></i> @o.PhoneNumber</span>
                                </td>

                                <td class="text-end price-text">
                                    @o.Total.ToString("N0") đ
                                </td>

                                <td class="text-center">
                                    <span class="modern-badge @GetStatusStyle(o.Status)">
                                        @((OrderStatus)o.Status)
                                    </span>
                                </td>

                                <td>
                                    <div style="color: #334155; font-weight: 500;">@o.CreatedDate?.ToString("dd/MM/yyyy")</div>
                                    <div style="color: #94a3b8; font-size: 0.85em;"><i class="far fa-clock"></i> @o.CreatedDate?.ToString("HH:mm")</div>
                                </td>

                                <td class="text-center">
                                    <a href="/Admin/Order/Detail/@o.Id" class="btn-modern btn-outline-info-modern">
                                        Chi tiết <i class="fas fa-arrow-right" style="margin-left: 4px;"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fas fa-clipboard-list fa-3x mb-3" style="color: #cbd5e1;"></i>
                                <p class="mb-0">Không tìm thấy đơn hàng nào khớp với điều kiện lọc.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            var totalPages = Model.TotalPages;
            int windowSize = 5;
            int half = windowSize / 2;
            int startPage = Model.Page - half;
            int endPage = Model.Page + half;

            if (startPage < 1)
            {
                startPage = 1;
                endPage = Math.Min(windowSize, totalPages);
            }
            if (endPage > totalPages)
            {
                endPage = totalPages;
                startPage = Math.Max(1, totalPages - windowSize + 1);
            }

            // Gộp chuỗi Query String
            var queryString = $"?status={ViewBag.Status}&keyword={Context.Request.Query["keyword"]}&fromDate={Context.Request.Query["fromDate"]}&toDate={Context.Request.Query["toDate"]}";

            <nav aria-label="Page navigation">
                <ul class="modern-pagination">
                    <li class="@(Model.Page == 1 ? "disabled" : "")">
                        <a href="@queryString&page=1" title="Trang đầu">«</a>
                    </li>
                    <li class="@(Model.Page == 1 ? "disabled" : "")">
                        <a href="@queryString&page=@(Model.Page - 1)" title="Trang trước">‹</a>
                    </li>

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="@(i == Model.Page ? "active" : "")">
                            <a href="@queryString&page=@i">@i</a>
                        </li>
                    }

                    <li class="@(Model.Page == totalPages ? "disabled" : "")">
                        <a href="@queryString&page=@(Model.Page + 1)" title="Trang sau">›</a>
                    </li>
                    <li class="@(Model.Page == totalPages ? "disabled" : "")">
                        <a href="@queryString&page=@totalPages" title="Trang cuối">»</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>