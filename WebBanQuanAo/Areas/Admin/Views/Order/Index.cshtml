@using Data.DTO.Common
@using Data.Entity.Enums
@model PagedResult<Data.DTO.Order.OrderAdminDTO>

@{
    ViewData["Title"] = "Quản lý đơn hàng";

    var currentStatus = Context.Request.Query["status"].ToString();

    string GetStatusStyle(int statusId)
    {
        return statusId switch
        {
            0 => "status-new",
            1 => "status-info",
            2 => "status-shipping",
            3 => "status-success",
            4 => "status-danger",
            _ => "status-default"
        };
    }
}

<div class="container-fluid py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-end mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Quản lý đơn hàng</h2>
            <p class="text-muted mb-0">Theo dõi và xử lý các đơn đặt hàng mới nhất.</p>
        </div>

        <form method="get" class="d-flex align-items-center filter-bar">
            <i class="bi bi-funnel text-muted ms-3"></i>

            <select name="status" class="form-select filter-select" style="width: 220px;">
                <option value="">Tất cả trạng thái</option>
                @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                {
                    <option value="@((int)s)" selected="@(currentStatus == ((int)s).ToString())">
                        @s
                    </option>
                }
            </select>

            <button class="btn btn-primary rounded-pill px-4"
                    type="submit"
                    style="background: var(--primary-color); border:none;">
                Lọc
            </button>
        </form>
    </div>

    <div class="dashboard-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Liên lạc</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var o in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-bold" style="color: var(--primary-color)">#@o.Id</td>
                                <td>@(string.IsNullOrEmpty(o.FullName) ? "Khách vãng lai" : o.FullName)</td>
                                <td>@o.PhoneNumber</td>
                                <td class="text-end fw-bold">@o.Total.ToString("N0") đ</td>
                                <td class="text-center">
                                    <span class="status-badge @GetStatusStyle(o.Status)">
                                        @((OrderStatus)o.Status)
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @o.CreatedDate?.ToString("dd/MM/yyyy")<br />
                                    <span style="font-size: 0.75em">@o.CreatedDate?.ToString("HH:mm")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/Admin/Order/Detail/@o.Id" class="btn-action text-decoration-none">
                                        Chi tiết <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                Không có đơn hàng nào
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalItems > Model.PageSize)
    {
        var totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);

        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="?status=@currentStatus&page=@(Model.Page - 1)">‹</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" href="?status=@currentStatus&page=@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.Page == totalPages ? "disabled" : "")">
                    <a class="page-link" href="?status=@currentStatus&page=@(Model.Page + 1)">›</a>
                </li>
            </ul>
        </nav>
    }

</div>
