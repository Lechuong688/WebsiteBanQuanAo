@using Data.DTO.Common
@using Data.Entity.Enums
@model PagedResult<Data.DTO.Order.OrderAdminDTO>

@{
    ViewData["Title"] = "Quản lý đơn hàng";

    var currentStatus = Context.Request.Query["status"].ToString();

    string GetStatusStyle(int statusId)
    {
        return statusId switch
        {
            0 => "status-new",
            1 => "status-info",
            2 => "status-shipping",
            3 => "status-success",
            4 => "status-danger",
            _ => "status-default"
        };
    }
}

<div class="container-fluid py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-end mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Quản lý đơn hàng</h2>
            <p class="text-muted mb-0">Theo dõi và xử lý các đơn đặt hàng mới nhất.</p>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body py-3">

                <form method="get" class="row g-2 align-items-center">

                    <div class="col-auto">
                        <span class="fw-semibold text-muted">
                            <i class="bi bi-funnel me-1"></i> Bộ lọc
                        </span>
                    </div>

                    <div class="col-md-2">
                        <select name="status" class="form-select">
                            <option value="">Tất cả trạng thái</option>
                            @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                            {
                                <option value="@((int)s)" selected="@(currentStatus == ((int)s).ToString())">
                                    @s
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <input type="text"
                               name="keyword"
                               value="@Context.Request.Query["keyword"]"
                               class="form-control"
                               placeholder="Tên khách hàng..." />
                    </div>

                    <div class="col-md-2">
                        <input type="date"
                               name="fromDate"
                               value="@Context.Request.Query["fromDate"]"
                               class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <input type="date"
                               name="toDate"
                               value="@Context.Request.Query["toDate"]"
                               class="form-control" />
                    </div>

                    <div class="col-auto">
                        <button class="btn btn-primary px-4">
                            <i class="bi bi-search me-1"></i> Lọc
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>

    <div class="dashboard-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Liên lạc</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var o in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-bold" style="color: var(--primary-color)">#@o.Id</td>
                                <td>@(string.IsNullOrEmpty(o.FullName) ? "Khách vãng lai" : o.FullName)</td>
                                <td>@o.PhoneNumber</td>
                                <td class="text-end fw-bold">@o.Total.ToString("N0") đ</td>
                                <td class="text-center">
                                    <span class="status-badge @GetStatusStyle(o.Status)">
                                        @((OrderStatus)o.Status)
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @o.CreatedDate?.ToString("dd/MM/yyyy")<br />
                                    <span style="font-size: 0.75em">@o.CreatedDate?.ToString("HH:mm")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/Admin/Order/Detail/@o.Id" class="btn-action text-decoration-none">
                                        Chi tiết <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                Không có đơn hàng nào
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @{
        var totalPages = Model.TotalPages;

        int windowSize = 5;
        int half = windowSize / 2;

        int startPage = Model.Page - half;
        int endPage = Model.Page + half;

        if (startPage < 1)
        {
            startPage = 1;
            endPage = Math.Min(windowSize, totalPages);
        }

        if (endPage > totalPages)
        {
            endPage = totalPages;
            startPage = Math.Max(1, totalPages - windowSize + 1);
        }
    }
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                <!-- First -->
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="?status=@ViewBag.Status&keyword=@Context.Request.Query["keyword"]&fromDate=@Context.Request.Query["fromDate"]&toDate=@Context.Request.Query["toDate"]&page=1">
                        «
                    </a>
                </li>

                <!-- Previous -->
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="?status=@ViewBag.Status&keyword=@Context.Request.Query["keyword"]&fromDate=@Context.Request.Query["fromDate"]&toDate=@Context.Request.Query["toDate"]&page=@(Model.Page - 1)">
                        ‹
                    </a>
                </li>

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link"
                           href="?status=@ViewBag.Status&keyword=@Context.Request.Query["keyword"]&fromDate=@Context.Request.Query["fromDate"]&toDate=@Context.Request.Query["toDate"]&page=@i">
                            @i
                        </a>
                    </li>
                }

                <!-- Next -->
                <li class="page-item @(Model.Page == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="?status=@ViewBag.Status&keyword=@Context.Request.Query["keyword"]&fromDate=@Context.Request.Query["fromDate"]&toDate=@Context.Request.Query["toDate"]&page=@(Model.Page + 1)">
                        ›
                    </a>
                </li>

                <!-- Last -->
                <li class="page-item @(Model.Page == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="?status=@ViewBag.Status&keyword=@Context.Request.Query["keyword"]&fromDate=@Context.Request.Query["fromDate"]&toDate=@Context.Request.Query["toDate"]&page=@totalPages">
                        »
                    </a>
                </li>

            </ul>
        </nav>
    }
</div>
