@using Data.Entity.Enums
@model Data.DTO.Order.OrderAdminDetailDTO
@section Styles {
    <link rel="stylesheet" href="~/css/admin/orderadmin.css" />
}
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Id}";

    // Cập nhật lại hàm lấy màu map thẳng với Soft Badge và Enum cho an toàn tuyệt đối
    string GetStatusColor(int statusId)
    {
        return statusId switch
        {
            (int)OrderStatus.New => "badge-soft-primary",
            (int)OrderStatus.Confirmed => "badge-soft-info",
            (int)OrderStatus.Shipping => "badge-soft-warning",
            (int)OrderStatus.Completed => "badge-soft-success",
            (int)OrderStatus.Cancelled => "badge-soft-danger",
            _ => "badge-soft-secondary"
        };
    }
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="modern-page-title" style="color: #3b82f6; font-family: monospace;">#@Model.Id</h1>
            <p class="page-subtitle"><i class="far fa-clock"></i> Ngày tạo: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="btn-modern-default">
            <i class="fas fa-arrow-left me-2"></i> Trở về danh sách
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">

            <div class="modern-card">
                <div class="modern-card-header">
                    <h4 class="modern-card-title"><i class="fas fa-map-marker-alt text-primary"></i> Thông tin giao hàng</h4>
                </div>
                <div class="modern-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-box">
                                <span class="info-label">Khách hàng</span>
                                <div class="info-value fw-bold text-primary">@Model.FullName</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <span class="info-label">Số điện thoại</span>
                                <div class="info-value">
                                    <i class="fas fa-phone-alt text-muted" style="font-size: 0.8em; margin-right: 5px;"></i> @Model.PhoneNumber
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <span class="info-label">Email</span>
                                <div class="info-value">
                                    <a href="mailto:@Model.Email" class="text-decoration-none text-dark">@Model.Email</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <span class="info-label">Địa chỉ nhận hàng</span>
                                <div class="info-value">@Model.Address</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modern-card">
                <div class="modern-card-header">
                    <h4 class="modern-card-title"><i class="fas fa-box-open text-primary"></i> Sản phẩm đã đặt</h4>
                </div>
                <div class="table-responsive">
                    <table class="table modern-table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Phân loại</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Items)
                            {
                                <tr>
                                    <td class="fw-bold" style="color: #0f172a;">@i.ProductName</td>
                                    <td class="text-center">
                                        <span class="modern-badge badge-soft-secondary" style="padding: 4px 10px; font-weight: 500;">
                                            @i.ColorName / @i.SizeName
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold">x @i.Quantity</td>
                                    <td class="text-end text-muted">@i.Price.ToString("N0") đ</td>
                                    <td class="text-end fw-bold" style="color: #3b82f6;">@((i.Price * i.Quantity).ToString("N0")) đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">

            <div class="modern-card">
                <div class="modern-card-header">
                    <h4 class="modern-card-title"><i class="fas fa-receipt text-primary"></i> Hóa đơn tạm tính</h4>
                </div>
                <div class="modern-card-body">
                    <div class="summary-row">
                        <span>Tổng tiền hàng</span>
                        <span class="fw-bold text-dark">@Model.SubTotal.ToString("N0") đ</span>
                    </div>
                    <div class="summary-row">
                        <span>Phí vận chuyển</span>
                        <span class="fw-bold text-dark">@Model.ShippingFee.ToString("N0") đ</span>
                    </div>

                    @if (Model.DiscountAmount != null && Model.DiscountAmount > 0)
                    {
                        <div class="summary-row text-success">
                            <span>Giảm giá</span>
                            <span class="fw-bold">- @Model.DiscountAmount?.ToString("N0") đ</span>
                        </div>
                    }
                    else
                    {
                        <div class="summary-row">
                            <span>Giảm giá</span>
                            <span class="fw-bold">0 đ</span>
                        </div>
                    }

                    <div class="summary-total">
                        <span>TỔNG CỘNG</span>
                        <span>@Model.Total.ToString("N0") đ</span>
                    </div>
                </div>
            </div>

            <div class="modern-card">
                <div class="modern-card-header">
                    <h4 class="modern-card-title"><i class="fas fa-tasks text-primary"></i> Tiến trình đơn hàng</h4>
                </div>
                <div class="modern-card-body">

                    <div class="mb-4" style="text-align: center;">
                        <span class="modern-badge @GetStatusColor(Model.Status)" style="font-size: 1rem; width: 100%; padding: 12px;">
                            @((OrderStatus)Model.Status)
                        </span>
                    </div>

                    @if (Model.Status < (int)OrderStatus.Completed && Model.Status != (int)OrderStatus.Cancelled)
                    {
                        <form method="post" id="updateStatusForm" action="/Admin/Order/UpdateStatus">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@Model.Id" />

                            <div class="modern-form-group">
                                <label class="modern-label">Cập nhật trạng thái mới</label>
                                <select name="status" id="orderStatusSelect" class="modern-control mb-3">
                                    @if (Model.Status == (int)OrderStatus.New)
                                    {
                                        <option value="@((int)OrderStatus.Confirmed)">Xác nhận đơn (Confirmed)</option>
                                        <option value="@((int)OrderStatus.Cancelled)">Hủy đơn (Cancelled)</option>
                                    }
                                    else if (Model.Status == (int)OrderStatus.Confirmed)
                                    {
                                        <option value="@((int)OrderStatus.Shipping)">Đang giao (Shipping)</option>
                                        <option value="@((int)OrderStatus.Cancelled)">Hủy đơn (Cancelled)</option>
                                    }
                                    else if (Model.Status == (int)OrderStatus.Shipping)
                                    {
                                        <option value="@((int)OrderStatus.Completed)">Đã nhận hàng (Completed)</option>
                                    }
                                </select>
                            </div>

                            <button class="btn-modern-primary" type="submit">
                                <i class="fas fa-check-circle" style="margin-right: 6px;"></i> Lưu trạng thái
                            </button>
                        </form>
                    }

                    @if (Model.Status == (int)OrderStatus.Completed)
                    {
                        <div class="soft-alert soft-alert-success">
                            <i class="fas fa-check-circle mb-2" style="font-size: 1.5rem;"></i><br />
                            Đơn hàng đã giao thành công
                        </div>
                    }

                    @if (Model.Status == (int)OrderStatus.Cancelled)
                    {
                        <div class="soft-alert soft-alert-danger">
                            <i class="fas fa-times-circle mb-2" style="font-size: 1.5rem;"></i><br />
                            Đơn hàng đã bị hủy
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('updateStatusForm');
        const select = document.getElementById('orderStatusSelect');
        const cancelledValue = '@((int)OrderStatus.Cancelled)';

        if (!form || !select) return;

        form.addEventListener('submit', function (e) {
            if (select.value === cancelledValue) {
                const ok = confirm('Hành động này không thể hoàn tác.\nBạn có chắc chắn muốn hủy đơn hàng này không?');
                if (!ok) {
                    e.preventDefault();
                }
            }
        });
    });
</script>