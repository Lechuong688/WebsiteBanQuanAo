@using Data.DTO.Product
@using Data.DTO.Common
@model PagedResult<Data.DTO.Product.ProductListDTO>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    var currentStatus = Context.Request.Query["status"].ToString();
}

<div class="container-fluid py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0 text-primary fw-bold">
                <i class="fas fa-boxes me-2"></i> Quản lý sản phẩm
            </h4>
            <a href="@Url.Action("Save")" class="btn btn-success btn-sm">
                <i class="fas fa-plus-circle me-1"></i> Thêm sản phẩm mới
            </a>
        </div>
        <br/>
        <div class="p-3 border-bottom bg-light">
            <div class="row">
                <div class="col-md-4">
                    <div class="search-box">
                        <i class="fa fa-search search-icon"></i>
                        <input type="search"
                               id="searchProduct"
                               class="search-input"
                               placeholder="Tìm sản phẩm theo tên hoặc danh mục..."
                               autocomplete="off" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th>Tên sản phẩm</th>
                            <th>Ảnh</th>
                            <th>Giá</th>
                            <th class="text-center">Số lượng</th>
                            <th>Màu sắc</th>
                            <th>Kích cỡ</th>
                            <th scope="col" class="text-center" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr class="product-row" data-name="@item.Name">
                                    <td class="fw-bold text-dark">
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                    <td>
                                        @if (item.Files?.Count > 0)
                                        {
                                            <img src="@item.Files.FirstOrDefault()" class="product-img" alt="@item.Name" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="fas fa-image"></i> No Image</span>
                                        }
                                    </td>

                                    <td class="price-text">
                                        @string.Format("{0:N0} đ", item.Price)
                                    </td>

                                    <td class="text-center">
                                        @{
                                            string qClass = "bg-success";
                                            if (item.Quantity == 0) { qClass = "bg-danger"; }
                                            else if (item.Quantity < 10) { qClass = "bg-warning text-dark"; }
                                        }
                                        <span class="badge @qClass rounded-pill">
                                            @item.Quantity
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.Colors != null && item.Colors.Any())
                                        {
                                            var maxShow = 3;
                                            var colors = item.Colors.ToList();
                                            var hiddenCount = colors.Count - maxShow;

                                            foreach (var color in colors.Take(maxShow))
                                            {
                                                <span class="badge-color">@color</span>
                                            }

                                            if (hiddenCount > 0)
                                            {
                                                <span class="badge-more">+@hiddenCount</span>
                                            }
                                        }
                                    </td>

                                    <td>
                                        @if (item.Sizes != null)
                                        {
                                            foreach (var size in item.Sizes)
                                            {
                                                <span class="badge-size">@size</span>
                                            }
                                        }
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Save", "Product", new { area = "Admin", id = item.Id })"
                                               class="btn btn-outline-primary btn-sm action-btn"
                                               title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <a href="@Url.Action("Delete", "Product", new { area = "Admin", id = item.Id })"
                                               class="btn btn-outline-danger btn-sm action-btn"
                                               title="Xóa"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    Chưa có dữ liệu sản phẩm nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalItems > Model.PageSize)
        {
            var totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);

            <nav class="mt-4">
                <ul class="pagination justify-content-center">

                    <!-- First -->
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" href="?status=@currentStatus&page=1">
                            «
                        </a>
                    </li>

                    <!-- Previous -->
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" href="?status=@currentStatus&page=@(Model.Page - 1)">
                            ‹
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" href="?status=@currentStatus&page=@i">@i</a>
                        </li>
                    }

                    <!-- Next -->
                    <li class="page-item @(Model.Page == totalPages ? "disabled" : "")">
                        <a class="page-link" href="?status=@currentStatus&page=@(Model.Page + 1)">
                            ›
                        </a>
                    </li>

                    <!-- Last -->
                    <li class="page-item @(Model.Page == totalPages ? "disabled" : "")">
                        <a class="page-link" href="?status=@currentStatus&page=@totalPages">
                            »
                        </a>
                    </li>

                </ul>
            </nav>
        }
    </div>
</div>

<script>
    const searchInput = document.getElementById("searchProduct");

    searchInput.addEventListener("input", function () {
        const keyword = normalizeText(this.value);

        document.querySelectorAll(".product-row").forEach(row => {
            const name = normalizeText(row.dataset.name);

            if (keyword === "" || name.includes(keyword)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    });

    function normalizeText(text) {
        return text
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/đ/g, "d")
            .replace(/Đ/g, "d");
    }
</script>