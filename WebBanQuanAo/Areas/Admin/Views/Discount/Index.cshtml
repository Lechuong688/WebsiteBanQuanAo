@using Data.DTO.Product
@using Data.DTO.Common
@model PagedResult<Data.DTO.Discount.DiscountListDTO>

<section class="content-header">
    <h1>Quản lý giảm giá</h1>
</section>

<section class="content">
    <a href="/Admin/Discount/Save" class="btn btn-primary mb-3">
        <i class="fa fa-plus"></i> Thêm giảm giá
    </a>

    <div class="box box-primary">
        <div class="box-body">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th width="80">ID</th>
                        <th>Tên khuyến mãi</th>
                        <th>Giảm</th>
                        <th>Thời gian</th>
                        <th width="120">Trạng thái</th>
                        <th width="180">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Id</td>

                                <td>
                                    <strong>@item.Name</strong>
                                    @* @if (!string.IsNullOrEmpty(item.Note))
                                    {
                                        <br />
                                        <small class="text-muted">@item.Note</small>
                                    } *@
                                </td>

                                <td>
                                    <span class="label label-default">@item.Percent %</span>
                                </td>

                                <td>
                                    @if (item.StartDate != null || item.EndDate != null)
                                    {
                                        <span>
                                            @(item.StartDate?.ToString("dd/MM/yyyy") ?? "--")
                                            -
                                            @(item.EndDate?.ToString("dd/MM/yyyy") ?? "--")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>Không giới hạn</span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="label label-success">Đang bật</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Đã tắt</span>
                                    }
                                </td>

                                <td>
                                    <a href="/Admin/Discount/Save?id=@item.Id"
                                       class="btn btn-warning btn-sm">
                                        <i class="fa fa-edit"></i>
                                    </a>

                                    <a href="/Admin/Discount/Product?id=@item.Id"
                                       class="btn btn-info btn-sm"
                                       title="Gán sản phẩm">
                                        <i class="fa fa-link"></i>
                                    </a>


                                    <form method="post"
                                          action="/Admin/Discount/Delete"
                                          style="display:inline;">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Tắt Discount này?')">
                                            <i class="fa fa-power-off"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }

                    }
                </tbody>
            </table>
        </div>
    </div>

</section>
