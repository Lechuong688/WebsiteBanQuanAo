@using Data.DTO.Banner
@using Data.DTO.Common
@model PagedResult<Data.DTO.Banner.BannerListDTO>

@{
    ViewBag.Title = "Quản lý Banner";
    var pageIndex = Model.Page;
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin/banneradmin.css" />
}
<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h1 class="modern-page-title">Quản lý Banner</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mt-1 mb-0 bg-transparent p-0" style="font-size: 0.9rem;">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard/Dashboardv1" class="text-decoration-none text-muted">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/Admin/Collection/Index" class="text-decoration-none text-muted">Bộ sưu tập</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Danh sách Banner</li>
                </ol>
            </nav>
        </div>

        <div class="mt-3 mt-md-0">
            <a href="/Admin/Banner/Save" class="btn-modern-primary text-decoration-none">
                <i class="fa-solid fa-plus me-1"></i> Thêm mới Banner
            </a>
        </div>
    </div>

    <div class="modern-card">

        <div class="modern-toolbar">
            <form method="get" asp-action="Index" class="toolbar-row m-0 w-100">
                <div class="filter-group flex-grow-1">

                    <div class="search-wrapper" style="max-width: 400px;">
                        <i class="fa-solid fa-search"></i>
                        <input type="text"
                               name="keyword"
                               value="@ViewBag.Keyword"
                               class="modern-control"
                               placeholder="Tìm kiếm theo tiêu đề..." />
                    </div>

                    <select name="status" class="modern-control" style="min-width: 200px;">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="true" selected="@(ViewBag.Status?.ToString() == "True")">Đang hoạt động</option>
                        <option value="false" selected="@(ViewBag.Status?.ToString() == "False")">Đang ẩn</option>
                    </select>

                    <button type="submit" class="btn-modern-primary px-4">
                        Lọc kết quả
                    </button>

                    <a href="/Admin/Banner/Index" class="btn-modern-default">
                        Xóa lọc
                    </a>
                </div>
            </form>
        </div>

        <div class="modern-card-body p-0">
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th class="text-center" width="80">ID</th>
                            <th>Tiêu đề chính</th>
                            <th>Tiêu đề phụ</th>
                            <th>Nút bấm (CTA)</th>
                            <th class="text-center">Collection ID</th>
                            <th class="text-center">Thứ tự</th>
                            <th class="text-center">Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-center" width="120">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-center text-muted">#@item.Id</td>

                                    <td class="fw-bold" style="color: #0f172a;">@item.Title</td>

                                    <td class="text-muted">
                                        <span class="banner-subtitle" title="@item.SubTitle">
                                            @(string.IsNullOrEmpty(item.SubTitle) ? "--" : item.SubTitle)
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ButtonText))
                                        {
                                            <span class="banner-btn-preview">@item.ButtonText</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">--</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <span class="banner-collection-id">@item.CollectionId</span>
                                    </td>

                                    <td class="text-center fw-semibold">@item.DisplayOrder</td>

                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="modern-badge badge-soft-success">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="modern-badge badge-soft-secondary">Đang ẩn</span>
                                        }
                                    </td>

                                    <td>
                                        <div style="color: #334155; font-size: 0.95rem;">@(item.CreatedDate?.ToString("dd/MM/yyyy") ?? "--")</div>
                                    </td>

                                    <td class="text-center">
                                        <div style="display: flex; gap: 6px; justify-content: center; align-items: center;">
                                            <a asp-action="Save" asp-route-id="@item.Id"
                                               class="btn-action btn-outline-info-modern text-decoration-none" title="Sửa">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  style="display:inline; margin: 0;"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn Tắt Banner này không?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action btn-outline-danger-modern" title="Tắt">
                                                    <i class="fa fa-power-off"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-images fa-3x mb-3" style="color: #cbd5e1;"></i>
                                    <p class="mb-0">Chưa có dữ liệu Banner nào.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalItems > Model.PageSize)
        {
            <div class="py-3 bg-white" style="border-top: 1px solid #e2e8f0; border-radius: 0 0 12px 12px;">
                @{
                    var totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
                    var currentKeyword = ViewBag.Keyword as string;
                    var currentStatus = ViewBag.Status as string;

                    // Thuật toán trượt trang (Sliding Window)
                    int windowSize = 5;
                    int half = windowSize / 2;
                    int startPage = Model.Page - half;
                    int endPage = Model.Page + half;

                    if (startPage < 1) { startPage = 1; endPage = Math.Min(windowSize, totalPages); }
                    if (endPage > totalPages) { endPage = totalPages; startPage = Math.Max(1, totalPages - windowSize + 1); }

                    var queryString = $"?keyword={currentKeyword}&status={currentStatus}";
                }

                <nav aria-label="Page navigation">
                    <ul class="modern-pagination">

                        <li class="@(Model.Page == 1 ? "disabled" : "")">
                            <a href="@(Model.Page == 1 ? "javascript:void(0)" : $"{queryString}&page={Model.Page - 1}")" title="Trang trước">‹</a>
                        </li>

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="@(i == Model.Page ? "active" : "")">
                                <a href="@queryString&page=@i">@i</a>
                            </li>
                        }

                        <li class="@(Model.Page == totalPages ? "disabled" : "")">
                            <a href="@(Model.Page == totalPages ? "javascript:void(0)" : $"{queryString}&page={Model.Page + 1}")" title="Trang sau">›</a>
                        </li>

                    </ul>
                </nav>
            </div>
        }
    </div>
</div>