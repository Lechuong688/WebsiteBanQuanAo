@using Data.DTO.Banner
@using Data.DTO.Common
@model PagedResult<Data.DTO.Banner.BannerListDTO>

@{
    ViewBag.Title = "Quản lý banner";
    var pageIndex = Model.Page;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <div>
            <h2 class="mb-0 text-dark">Quản lý Banner</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mt-2 mb-0 bg-transparent p-0">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard/Dashboardv1" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/Admin/Collection/Index" class="text-decoration-none">Quản lý bộ sưu tập</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Danh sách Banner</li>
                </ol>
            </nav>
        </div>

        <div class="mt-3 mt-md-0">
            <a href="/Admin/Banner/Save" class="btn btn-primary">
                <i class="fa-solid fa-plus me-1"></i> Thêm mới Banner
            </a>
        </div>
    </div>
    <br/>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">

                <div class="col-md-4">
                    <input type="text"
                           name="keyword"
                           value="@ViewBag.Keyword"
                           class="form-control"
                           placeholder="Tìm kiếm theo tiêu đề..." />
                </div>

                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="true"
                                selected="@(ViewBag.Status?.ToString() == "True")">
                            Đang hoạt động
                        </option>
                        <option value="false"
                                selected="@(ViewBag.Status?.ToString() == "False")">
                            Đang ẩn
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="fa-solid fa-search"></i> Tìm kiếm
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">ID</th>
                            <th>Tiêu đề</th>
                            <th>Tiêu đề phụ</th>
                            <th>Nút bấm</th>
                            <th class="text-center">Collection</th>
                            <th class="text-center">Thứ tự</th>
                            <th class="text-center">Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-center">@item.Id</td>
                                    <td class="fw-bold">@item.Title</td>
                                    <td class="text-muted">@item.SubTitle</td>
                                    <td>@item.ButtonText</td>
                                    <td class="text-center">@item.CollectionId</td>
                                    <td class="text-center">@item.DisplayOrder</td>

                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Đang ẩn</span>
                                        }
                                    </td>

                                    <td>@(item.CreatedDate?.ToString("dd/MM/yyyy") ?? "")</td>

                                    <td class="text-center">
                                        <a asp-action="Save" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Tắt Banner này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="fa fa-power-off"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4">
                                    Không có dữ liệu banner.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white py-3">
            @if (Model.TotalItems > Model.PageSize)
            {
                var totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
                var currentKeyword = ViewBag.Keyword as string;
                var currentStatus = ViewBag.Status as string;

                <nav class="mt-4">
                    <ul class="pagination justify-content-center">

                        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                            @if (Model.Page == 1)
                            {
                                <span class="page-link">‹</span>
                            }
                            else
                            {
                                <a class="page-link"
                                   href="?keyword=@currentKeyword&status=@currentStatus&page=@(Model.Page - 1)">
                                    ‹
                                </a>
                            }
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                @if (i == Model.Page)
                                {
                                    <span class="page-link">@i</span>
                                }
                                else
                                {
                                    <a class="page-link"
                                       href="?keyword=@currentKeyword&status=@currentStatus&page=@i">
                                        @i
                                    </a>
                                }
                            </li>
                        }

                        <li class="page-item @(Model.Page == totalPages ? "disabled" : "")">
                            @if (Model.Page == totalPages)
                            {
                                <span class="page-link">›</span>
                            }
                            else
                            {
                                <a class="page-link"
                                   href="?keyword=@currentKeyword&status=@currentStatus&page=@(Model.Page + 1)">
                                    ›
                                </a>
                            }
                        </li>

                    </ul>
                </nav>
            }
        </div>
    </div>
</div>