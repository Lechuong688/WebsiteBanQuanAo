@using WebBanQuanAo.Areas.Admin.Models
@using Data.DTO.Banner
@model BannerUpdateDTO
@{
    ViewBag.Title = Model.Id == 0 ? "Thêm Banner" : "Cập nhật Banner";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h2 class="mb-0 text-dark">Quản lý Banner</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mt-2 mb-0 bg-transparent p-0">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Danh sách Banner</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@(Model.Id == 0 ? "Thêm mới" : "Chỉnh sửa")</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 text-primary fw-bold">
                <i class="fa-regular fa-image me-2"></i>@(Model.Id == 0 ? "Thêm mới Banner" : "Chỉnh sửa thông tin Banner")
            </h5>
        </div>

        <div class="card-body p-4">
            <form asp-action="Save" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-lg-8">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Tiêu đề (Title) <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề chính..." />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Tiêu đề phụ (SubTitle)</label>
                                <input asp-for="SubTitle" class="form-control" placeholder="Nhập tiêu đề phụ..." />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Mô tả</label>
                                <input asp-for="Description" class="form-control" placeholder="Nhập mô tả..." />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Nút bấm (ButtonText)</label>
                                <input asp-for="ButtonText" class="form-control" placeholder="VD: Mua ngay, Khám phá..." />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Bộ sưu tập</label>

                                <select asp-for="CollectionId"
                                        class="form-select"
                                        asp-items="ViewBag.Collections">
                                    <option value="">-- Chọn bộ sưu tập --</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Thứ tự hiển thị</label>
                                <input asp-for="DisplayOrder" type="number" class="form-control" placeholder="1, 2, 3..." />
                            </div>

                            <div class="col-md-6 mb-3 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" style="transform: scale(1.2); margin-top: 0.25rem;" />
                                    <label class="form-check-label fw-semibold ms-2" for="isActiveSwitch">Kích hoạt hiển thị</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 mt-4 mt-lg-0">
                        <div class="card border border-light-subtle shadow-none h-100 bg-light">
                            <div class="card-body text-center d-flex flex-column justify-content-center">
                                <label class="form-label fw-semibold mb-3">Ảnh Banner</label>

                                <div class="mb-3 border rounded d-flex justify-content-center align-items-center bg-white overflow-hidden mx-auto"
                                     style="width: 100%; height: 200px; border-style: dashed !important;">

                                    @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                                    {
                                        <img id="imagePreview"
                                             src="@Model.ExistingImagePath"
                                             alt="Preview"
                                             style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <img id="imagePreview"
                                             src="#"
                                             alt="Preview"
                                             style="max-width: 100%; max-height: 100%; object-fit: contain; display:none;" />

                                        <div id="uploadPlaceholder" class="text-muted">
                                            <i class="fa-solid fa-cloud-arrow-up fs-1 mb-2"></i>
                                            <p class="mb-0 small">Chưa có ảnh nào được chọn</p>
                                        </div>
                                    }

                                </div>

                                <input asp-for="ImageFile" type="file" class="form-control" id="imageInput" accept="image/*" />
                                <small class="text-muted mt-2 d-block">Định dạng hỗ trợ: .jpg, .png, .jpeg</small>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4 text-muted">

                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4 me-2">
                        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Banner
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
                document.getElementById('imageInput').addEventListener('change', function(event) {
            var file = event.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.getElementById('imagePreview');
                    img.src = e.target.result;
                    img.style.display = 'block';

                    var placeholder = document.getElementById('uploadPlaceholder');
                    if (placeholder) {
                        placeholder.style.display = 'none';
                    }
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}