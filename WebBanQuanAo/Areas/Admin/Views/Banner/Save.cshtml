@using WebBanQuanAo.Areas.Admin.Models
@using Data.DTO.Banner
@model BannerUpdateDTO
@{
    ViewBag.Title = Model.Id == 0 ? "Thêm Banner" : "Cập nhật Banner";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin/banneradmin.css" />
}
<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h1 class="modern-page-title">Quản lý Banner</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mt-1 mb-0 bg-transparent p-0" style="font-size: 0.9rem;">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Danh sách Banner</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">@(Model.Id == 0 ? "Thêm mới" : "Chỉnh sửa")</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="modern-card">
        <div class="modern-card-header">
            <h4 class="modern-card-title">
                <i class="fa-regular fa-image text-primary"></i>
                @(Model.Id == 0 ? "Thêm mới Banner" : "Chỉnh sửa thông tin Banner")
            </h4>
        </div>

        <div class="modern-card-body">
            <form asp-action="Save" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-lg-8">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="modern-form-group">
                                    <label class="modern-label">Tiêu đề chính (Title) <span class="text-danger">*</span></label>
                                    <input asp-for="Title" class="modern-control" placeholder="Ví dụ: Khuyến mãi mùa hè..." />
                                    <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="modern-form-group">
                                    <label class="modern-label">Tiêu đề phụ (SubTitle)</label>
                                    <input asp-for="SubTitle" class="modern-control" placeholder="Ví dụ: Giảm giá lên đến 50%..." />
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="modern-form-group">
                                    <label class="modern-label">Mô tả ngắn</label>
                                    <input asp-for="Description" class="modern-control" placeholder="Nhập mô tả chi tiết cho banner..." />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="modern-form-group">
                                    <label class="modern-label">Nút bấm (Call to Action)</label>
                                    <input asp-for="ButtonText" class="modern-control" placeholder="VD: Mua ngay, Khám phá..." />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="modern-form-group">
                                    <label class="modern-label">Gắn với Bộ sưu tập (Tùy chọn)</label>
                                    <select asp-for="CollectionId" class="modern-control" asp-items="ViewBag.Collections">
                                        <option value="">-- Không gắn bộ sưu tập --</option>
                                    </select>
                                    <span asp-validation-for="CollectionId" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="modern-form-group">
                                    <label class="modern-label">Thứ tự hiển thị</label>
                                    <input asp-for="DisplayOrder" type="number" class="modern-control" placeholder="1, 2, 3..." />
                                </div>
                            </div>

                            <div class="col-md-6 d-flex align-items-center">
                                <div class="modern-form-group" style="margin-bottom: 0;">
                                    <label class="toggle-wrapper" style="margin-top: 15px;">
                                        <input asp-for="IsActive" type="checkbox" class="modern-toggle" />
                                        <span class="toggle-label-text">Kích hoạt hiển thị Banner</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 mt-4 mt-lg-0">
                        <div class="modern-form-group h-100 d-flex flex-column">
                            <label class="modern-label">Hình ảnh Banner <span class="text-danger">*</span></label>

                            <div class="flex-grow-1 border rounded d-flex justify-content-center align-items-center bg-light overflow-hidden mb-3"
                                 style="border: 2px dashed #cbd5e1 !important; min-height: 220px; border-radius: 12px !important; position: relative;">

                                @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                                {
                                    <img id="imagePreview" src="@Model.ExistingImagePath" alt="Preview" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                                    <div id="uploadPlaceholder" style="display:none; text-align:center;">
                                        <i class="fa-solid fa-cloud-arrow-up fs-2 mb-2 text-primary"></i>
                                        <p class="mb-0 text-muted" style="font-size: 0.9rem;">Click để chọn ảnh mới</p>
                                    </div>
                                }
                                else
                                {
                                    <img id="imagePreview" src="#" alt="Preview" style="max-width: 100%; max-height: 100%; object-fit: contain; display:none;" />
                                    <div id="uploadPlaceholder" style="text-align:center; padding: 20px;">
                                        <i class="fa-solid fa-cloud-arrow-up fs-1 mb-2 text-primary"></i>
                                        <p class="mb-0 text-muted" style="font-size: 0.95rem;">Chưa có ảnh nào được chọn</p>
                                    </div>
                                }
                            </div>

                            <input asp-for="ImageFile" type="file" class="modern-control" id="imageInput" accept="image/png, image/jpeg, image/jpg, image/webp" />
                            <small class="text-muted mt-2 d-block text-center">Định dạng hỗ trợ: .jpg, .png, .webp</small>
                        </div>
                    </div>
                </div>

                <div class="modern-btn-group">
                    <button type="submit" class="btn-modern-primary">
                        <i class="fa-solid fa-save me-2"></i> Lưu Banner
                    </button>
                    <a asp-action="Index" class="btn-modern-default">
                        <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script> 
        document.getElementById('imageInput').addEventListener('change', function(event) {
            var file = event.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.getElementById('imagePreview');
                    img.src = e.target.result;
                    img.style.display = 'block';

                    var placeholder = document.getElementById('uploadPlaceholder');
                    if (placeholder) {
                        placeholder.style.display = 'none';
                    }
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}