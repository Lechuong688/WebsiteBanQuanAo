@model Data.DTO.Dashboard.DashboardViewModel

@{
    ViewBag.Title = "Dashboardv1";
}

<section class="content-header">

    <h1>
        Dashboard
        <small>Bảng điều khiển</small>
    </h1>

    <ol class="breadcrumb">

        <li>
            <input class="daterange"
                   id="dashboard-date-range" />
        </li>

    </ol>

</section>

<section class="content">

    <!-- SUMMARY -->

    <div class="row">

        <!-- TOTAL ORDER -->

        <div class="col-lg-3 col-xs-6">

            <div class="small-box bg-aqua">

                <div class="inner">

                    <h3>
                        @Model.Summary.TotalOrders
                    </h3>

                    <p>Tổng đơn hàng</p>

                </div>

                <div class="icon">
                    <i class="ion ion-bag"></i>
                </div>

                <a href="/Admin/Order"
                   class="small-box-footer">

                    Chi tiết
                    <i class="fa fa-arrow-circle-right"></i>

                </a>

            </div>

        </div>

        <!-- REVENUE -->

        <div class="col-lg-3 col-xs-6">

            <div class="small-box bg-green">

                <div class="inner">

                    <h3>
                        @Model.Summary.TotalRevenue.ToString("N0") đ
                    </h3>

                    <p>Tổng doanh thu</p>

                </div>

                <div class="icon">
                    <i class="ion ion-stats-bars"></i>
                </div>

                <a href="#"
                   class="small-box-footer">

                    Chi tiết
                    <i class="fa fa-arrow-circle-right"></i>

                </a>

            </div>

        </div>

        <!-- USERS -->

        <div class="col-lg-3 col-xs-6">

            <div class="small-box bg-yellow">

                <div class="inner">

                    <h3>
                        @Model.Summary.TotalUsers
                    </h3>

                    <p>Người dùng</p>

                </div>

                <div class="icon">
                    <i class="ion ion-person-add"></i>
                </div>

                <a href="/Admin/User"
                   class="small-box-footer">

                    Chi tiết
                    <i class="fa fa-arrow-circle-right"></i>

                </a>

            </div>

        </div>

        <!-- SOLD -->

        <div class="col-lg-3 col-xs-6">

            <div class="small-box bg-red">

                <div class="inner">

                    <h3>
                        @Model.Summary.ProductsSold
                    </h3>

                    <p>Tổng sản phẩm đã bán</p>

                </div>

                <div class="icon">
                    <i class="ion ion-pie-graph"></i>
                </div>

                <a href="#"
                   class="small-box-footer">

                    Chi tiết
                    <i class="fa fa-arrow-circle-right"></i>

                </a>

            </div>

        </div>

    </div>

    <div class="row">

        <!-- LEFT -->
        <section class="col-lg-7 connectedSortable">

            <!-- REVENUE -->
            <div class="box box-primary">

                <div class="box-header with-border">

                    <h3 class="box-title">

                        <i class="fa fa-line-chart"></i>
                        Thống kê doanh thu

                    </h3>

                    <div class="pull-right">

                        <select id="chart-mode"
                                class="form-control">

                            <option value="day">Ngày</option>

                            <option value="week">Tuần</option>

                            <option value="month" selected>
                                Tháng
                            </option>

                            <option value="quarter">Quý</option>

                            <option value="year">Năm</option>

                        </select>

                    </div>

                </div>

                <div class="box-body">

                    <div id="revenue-chart"
                         style="height:350px">
                    </div>

                </div>

            </div>

            <!-- TOP PRODUCT -->
            <div class="box box-info">

                <div class="box-header with-border">

                    <h3 class="box-title">

                        Top sản phẩm bán chạy

                    </h3>

                    <div class="pull-right">

                        <select id="top-product-limit"
                                class="form-control">

                            <option value="5">
                                Top 5
                            </option>

                            <option value="10" selected>
                                Top 10
                            </option>

                            <option value="20">
                                Top 20
                            </option>

                        </select>

                    </div>

                </div>

                <div class="box-body table-responsive"
                     style="max-height:400px">

                    <table class="table table-bordered table-hover">

                        <thead>

                            <tr>

                                <th>Ảnh</th>

                                <th>Sản phẩm</th>

                                <th>Đã bán</th>

                                <th>Doanh thu</th>

                            </tr>

                        </thead>

                        <tbody id="top-product-body">

                            @foreach (var item in Model.TopProducts)
                            {
                                <tr>

                                    <td style="width:70px">

                                        <img src="@item.ImagePath"
                                             style="
                                                    width:50px;
                                                    height:50px;
                                                    object-fit:cover;
                                                    border-radius:8px" />

                                    </td>

                                    <td>
                                        @item.ProductName
                                    </td>

                                    <td>
                                        @item.QuantitySold
                                    </td>

                                    <td>
                                        @item.Revenue.ToString("N0") đ
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- LOW STOCK -->
            <div class="box box-danger">

                <div class="box-header with-border">

                    <h3 class="box-title">

                        Sản phẩm sắp hết hàng

                    </h3>

                    <div class="pull-right">

                        <select id="low-stock-limit"
                                class="form-control">

                            <option value="5">
                                Dưới 5
                            </option>

                            <option value="10">
                                Dưới 10
                            </option>

                            <option value="20">
                                Dưới 20
                            </option>

                        </select>

                    </div>

                </div>

                <div class="box-body table-responsive"
                     style="max-height:350px">

                    <table class="table table-bordered table-hover">

                        <thead>

                            <tr>

                                <th>Ảnh</th>

                                <th>Sản phẩm</th>

                                <th>Tồn kho</th>

                            </tr>

                        </thead>

                        <tbody id="low-stock-body">

                            @foreach (var item in Model.LowStockProducts)
                            {
                                <tr>

                                    <td style="width:70px">

                                        <img src="@item.ImagePath"
                                             style="
                                                    width:50px;
                                                    height:50px;
                                                    object-fit:cover;
                                                    border-radius:8px" />

                                    </td>

                                    <td>
                                        @item.ProductName
                                    </td>

                                    <td>

                                        <span class="label"
                                              style="
                                            background:
                                            @(item.Quantity <= 5
                                                          ? "#dd4b39"
                                                          : item.Quantity <= 10
                                                          ? "#f39c12"
                                                          : "#3c8dbc");
                                                color:white;
                                              ">

                                            @item.Quantity

                                        </span>


                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </section>

        <!-- RIGHT -->
        <section class="col-lg-5 connectedSortable">

            <!-- RECENT ORDER -->
            <div class="box box-success">

                <div class="box-header with-border">

                    <h3 class="box-title">

                        Đơn hàng gần đây

                    </h3>

                    <div class="pull-right">

                        <select id="recent-order-limit"
                                class="form-control">

                            <option value="5">
                                5 đơn
                            </option>

                            <option value="10" selected>
                                10 đơn
                            </option>

                            <option value="20">
                                20 đơn
                            </option>

                        </select>

                    </div>

                </div>

                <div class="box-body table-responsive"
                     style="max-height:700px">

                    <table class="table table-bordered table-hover">

                        <thead>

                            <tr>

                                <th>Mã đơn</th>

                                <th>Khách</th>

                                <th>Tổng</th>

                                <th>Trạng thái</th>

                            </tr>

                        </thead>

                        <tbody id="recent-order-body">

                            @foreach (var item in Model.RecentOrders)
                            {
                                <tr>

                                    <td>
                                        @item.TransactionCode
                                    </td>

                                    <td>
                                        @item.CustomerName
                                    </td>

                                    <td>
                                        @item.TotalAmount.ToString("N0") đ
                                    </td>

                                    <td>

                                        <span class="label">

                                            @item.Status

                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- ORDER STATUS -->
            <div class="box box-warning">

                <div class="box-header with-border">

                    <h3 class="box-title">
                        Trạng thái đơn hàng
                    </h3>
                    <div class="pull-right">

                        <select id="order-status-type"
                                class="form-control">

                            <option value="donut" selected>
                                Donut
                            </option>

                            <option value="bar">
                                Bar
                            </option>

                        </select>

                    </div>
                </div>
                <div class="box-body">
                    <div id="order-status-chart"
                         style="height:350px">
                    </div>

                </div>

            </div>

        </section>

    </div>
</section>

@section Scripts
{
    <script src="~/webbanquanao/js/pages/dashboard.js"></script>
    <script>
        $('.connectedSortable').sortable({

                    placeholder: 'sort-highlight',

                    connectWith: '.connectedSortable',

                    handle: '.box-header',

                    forcePlaceholderSize: true,

                    zIndex: 999999

                });</script>
}
