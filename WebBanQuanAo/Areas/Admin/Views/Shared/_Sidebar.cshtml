@using WebBanQuanAo.Helpers
<!-- Left side column. contains the logo and sidebar -->
<aside class="main-sidebar">
    <!-- sidebar: style can be found in sidebar.less -->
    <section class="sidebar">
        <!-- Sidebar user panel -->
        <div class="user-panel">
            <div class="pull-left image">
                <img src="~/img/user2-160x160.jpg" class="img-circle" alt="User Image">
            </div>
            <div class="pull-left info">
                @if (User.Identity.IsAuthenticated)
                {
                    <p>@User.Identity.Name</p>
                }
                else
                {
                    <p>Khách</p>
                }
                <a href="#"><i class="fa fa-circle text-success"></i> Online</a>
            </div>
        </div>
        <!-- search form -->
        <form asp-controller="Product" asp-action="Index" method="get" class="sidebar-form">
            <div class="input-group">
                <input type="text" name="keyword" class="form-control" placeholder="Tìm kiếm sản phẩm...">
                <span class="input-group-btn">
                    <button type="submit" id="search-btn" class="btn btn-flat">
                        <i class="fa fa-search"></i>
                    </button>
                </span>
            </div>
        </form>
        <!-- /.search form -->
        <!-- sidebar menu: : style can be found in sidebar.less -->
        <ul class="sidebar-menu" data-widget="tree">
            <li class="header">MAIN NAVIGATION</li>
            <li class="@Html.IsSelected(controller: "Dashboard")">
                <a href="@Url.Action("Dashboardv1", "Dashboard")">
                    <i class="fa fa-dashboard"></i> <span>Dashboard</span>
                </a>
            </li>
            <li class="@Html.IsSelected(controller: "User")">
                <a href="@Url.Action("Index", "User")">
                    <i class="fa fa-users"></i> <span>Quản lý người dùng</span>
                </a>
            </li>
            <li class="@Html.IsSelected(controller: "Product")">
                <a href="@Url.Action("Index", "Product")">
                    <i class="fa fa-box-open"></i> <span>Quản lý sản phẩm</span>
                </a>
            </li>
            <li class="@Html.IsSelected(controller: "Category")">
                <a href="@Url.Action("Index", "Category")">
                    <i class="fa fa-layer-group"></i> <span>Quản lý danh mục</span>
                </a>
            </li>
            <li class="@Html.IsSelected(controller: "Order")">
                <a href="@Url.Action("Index", "Order")">
                    <i class="fa fa-shopping-cart"></i> <span>Quản lý đơn hàng</span>
                </a>
            </li>
            <li class="@Html.IsSelected(controller: "Attribute")">
                <a href="@Url.Action("Index", "Attribute")">
                    <i class="fa fa-sliders-h"></i> <span>Quản lý thuộc tính</span>
                </a>
            </li>
            <li class="@Html.IsSelected(controller: "Collection")">
                <a href="@Url.Action("Index", "Collection")">
                    <i class="fa fa-images"></i> <span>Quản lý bộ sưu tập</span>
                </a>
            </li>@* 
            <li class="@Html.IsSelected(controller: "Banner")">
                <a href="@Url.Action("Index", "Banner")">
                    <i class="fa fa-th"></i> <span>Quản lý banner</span>
                </a>
            </li> *@
            <li class="@Html.IsSelected(controller: "Discount")">
                <a href="@Url.Action("Index", "Discount")">
                    <i class="fa fa-percent"></i> <span>Quản lý giảm giá</span>
                </a>
            </li>
            @* <li><a href="https://adminlte.io/docs"><i class="fa fa-book"></i> <span>Documentation</span></a></li>
            <li class="header">LABELS</li>
            <li><a href="#"><i class="fa fa-circle-o text-red"></i> <span>Important</span></a></li>
            <li><a href="#"><i class="fa fa-circle-o text-yellow"></i> <span>Warning</span></a></li>
            <li><a href="#"><i class="fa fa-circle-o text-aqua"></i> <span>Information</span></a></li> *@
        </ul>
    </section>
    <!-- /.sidebar -->
</aside>
