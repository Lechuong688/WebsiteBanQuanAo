@* <div class="content-wrapper"> *@
<section class="content-header">
    <h1 class="modern-page-title">Quản lý Người Dùng</h1>
</section>

<section class="content">
    <div class="modern-toolbar">
        <div class="toolbar-group">
            <a href="/Admin/User/CreateUser" class="btn-modern-primary">
                <i class="fa fa-plus"></i> Thêm người dùng
            </a>
        </div>

        <div class="toolbar-group">
            <div style="position: relative;">
                <input type="text"
                       id="keyword"
                       class="modern-control"
                       placeholder="Nhập từ khóa tìm kiếm..."
                       style="width:250px;" />
            </div>

            <button class="btn-modern-primary" onclick="loadUsers(1)">
                <i class="fa fa-search"></i> Tìm
            </button>

            <div class="page-size-wrapper">
                <span>Hiển thị</span>
                <select id="pageSize"
                        class="modern-control"
                        style="padding: 6px 10px; cursor: pointer;"
                        onchange="changePageSize()">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <span>dòng</span>
            </div>
        </div>
    </div>

    <div id="userTable">
    </div>

</section>
@* </div> *@

@section Scripts {
    <script>
        $(document).ready(function () {
            loadUsers(1);

            // Bổ sung UX: Nhấn Enter ở ô tìm kiếm sẽ tự động gọi nút Tìm
            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) {
                    loadUsers(1);
                }
            });
        });

        function loadUsers(page) {
            $.ajax({
                url: '@Url.Action("LoadUsers", "User", new { area = "Admin" })',
                type: 'GET',
                data: {
                    page: page,
                    keyword: $('#keyword').val(),
                    pageSize: $('#pageSize').val()
                },
                success: function (res) {
                    $('#userTable').html(res);
                }
            });
        }

        function changePageSize() {
            loadUsers(1);
        }

        function goUpdateUser(id) {
            window.location.href = '/Admin/User/UpdateUser/' + id;
        }

        function goDeleteUser(id) {
            if (!confirm('Bạn có chắc muốn xóa người dùng này?'))
                return;

            $.ajax({
                url: '/Admin/User/DeleteUser',
                type: 'POST',
                data: { id: id },
                success: function () {
                    alert('Xóa người dùng thành công');
                    loadUsers(1);
                },
                error: function (xhr) {
                    if (xhr.responseText) {
                        alert(xhr.responseText);
                    } else {
                        alert('Không thể xóa người dùng');
                    }
                }
            });
        }

        function toggleLockUser(id) {
            if (!confirm('Bạn có chắc muốn thay đổi trạng thái khóa?')) return;

            $.ajax({
                url: '/Admin/User/ToggleLock',
                type: 'POST',
                data: { id: id },
                success: function () {
                    loadUsers(1);
                },
                error: function () {
                    alert('Có lỗi xảy ra');
                }
            });
        }
    </script>
}