@model WebBanQuanAo.Areas.Admin.Models.UpdateUserViewModel

@* <div class="content-wrapper"> *@
<section class="content-header">
    <h1 class="modern-page-title">Cập nhật thông tin tài khoản</h1>
</section>

<section class="content">

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h3 class="modern-card-title">Thông tin người dùng</h3>
                </div>

                <div class="modern-card-body">
                    <form asp-action="UpdateUser" method="post">
                        @Html.AntiForgeryToken()

                        <div class="modern-form-group">
                            <label class="modern-label">ID Người dùng</label>
                            <input type="text" class="modern-control"
                                   name="Id" readonly
                                   value="@Model.Id" />
                            <input type="hidden" asp-for="Id" />
                        </div>

                        <div class="modern-form-group">
                            <label class="modern-label">Họ tên</label>
                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "modern-control" } })
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-modern-danger" })
                        </div>

                        <div class="modern-form-group">
                            <label class="modern-label">Email</label>
                            <input type="text" class="modern-control"
                                   name="Email"
                                   value="@Model.Email" />
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-modern-danger" })
                        </div>

                        <div class="modern-form-group">
                            <label class="modern-label">Tên đăng nhập</label>
                            <input type="text" class="modern-control"
                                   name="UserName"
                                   value="@Model.UserName" />
                            @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-modern-danger" })
                        </div>

                        <div class="modern-form-group">
                            <label class="modern-label">Số điện thoại</label>
                            <input type="text" class="modern-control"
                                   name="PhoneNumber"
                                   value="@Model.PhoneNumber" />
                            @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-modern-danger" })
                        </div>

                        <div class="modern-form-group">
                            <label class="modern-label">Phân quyền</label>
                            <select name="SelectedRoles"
                                    class="modern-control select2"
                                    data-placeholder="Chọn quyền cho người dùng..."
                                    style="width: 100%;"
                                    multiple>
                                @foreach (var role in Model.AllRoles)
                                {
                                    <option value="@role" selected="@(Model.SelectedRoles != null && Model.SelectedRoles.Contains(role))">
                                        @role
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="modern-btn-group">
                            <button type="submit" class="btn-modern-primary">
                                <i class="fa fa-save" style="margin-right: 5px;"></i> Cập nhật
                            </button>
                            <a href="/Admin/User/Index" class="btn-modern-default">
                                Trở về danh sách
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@* </div> *@

@section scripts {
    <script>
        $(function () {
            $('.select2').select2({
                closeOnSelect: false,
                width: '100%'
            });
        });
    </script>
}