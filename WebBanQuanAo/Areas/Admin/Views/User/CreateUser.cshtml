@model WebBanQuanAo.Areas.Admin.Models.CreateUserViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/admin/useradmin.css" />
}
@* <div class="content-wrapper"> *@
<section class="content-header">
    <h1 class="modern-page-title">Thêm người dùng mới</h1>
</section>

<section class="content">

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h3 class="modern-card-title">Thông tin tài khoản</h3>
                </div>

                <div class="modern-card-body">
                    <form asp-action="CreateUser" method="post">
                        @Html.AntiForgeryToken()

                        <div class="modern-form-group">
                            <label class="modern-label">Họ tên</label>
                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "modern-control", placeholder = "Nhập họ và tên..." } })
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-modern-danger" })
                        </div>

                        <div class="modern-form-group">
                            <label class="modern-label">Email</label>
                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "modern-control", placeholder = "ví dụ: admin@domain.com" } })
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-modern-danger" })
                        </div>

                        <div class="modern-form-group">
                            <label class="modern-label">Tên đăng nhập</label>
                            @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "modern-control", placeholder = "Nhập tên tài khoản..." } })
                            @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-modern-danger" })
                        </div>

                        <div class="modern-form-group">
                            <label class="modern-label">Mật khẩu</label>
                            @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "modern-control", type = "password", placeholder = "••••••••" } })
                            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-modern-danger" })
                        </div>

                        <div class="modern-form-group">
                            <label class="modern-label">Xác nhận mật khẩu</label>
                            @Html.EditorFor(model => model.ConfirmPassword, new { htmlAttributes = new { @class = "modern-control", type = "password", placeholder = "••••••••" } })
                            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-modern-danger" })
                        </div>

                        <div class="modern-form-group">
                            <label class="modern-label">Số điện thoại</label>
                            @Html.EditorFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "modern-control", placeholder = "Nhập số điện thoại..." } })
                            @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-modern-danger" })
                        </div>

                        <div class="modern-btn-group">
                            <button type="submit" class="btn-modern-primary">
                                <i class="fa fa-save" style="margin-right: 5px;"></i> Lưu dữ liệu
                            </button>
                            <a href="/Admin/User/Index" class="btn-modern-default">
                                Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@* </div> *@