@model List<Data.Entity.UserEntity>
@section Styles {
    <link rel="stylesheet" href="~/css/useradmin.css" />
}
<div class="modern-card">
    <div class="table-responsive">
        <table class="table modern-table">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Tài khoản</th>
                    <th>Email</th>
                    <th>Trạng thái</th>
                    <th>Quyền</th>
                    <th class="text-center">Đóng/Mở</th>
                    <th class="text-center">Quản lý</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var isLocked = user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.Now;

                    <tr class="@(isLocked ? "row-locked" : "")">
                        <td class="fw-bold">
                            @(string.IsNullOrEmpty(user.Name) ? user.UserName : user.Name)
                        </td>
                        <td>@user.UserName</td>
                        <td><a href="mailto:@user.Email" class="text-decoration-none text-muted">@user.Email</a></td>
                        <td>
                            @if (isLocked)
                            {
                                <span class="modern-badge badge-soft-danger">Bị khóa</span>
                            }
                            else
                            {
                                <span class="modern-badge badge-soft-success">Hoạt động</span>
                            }
                        </td>
                        <td>
                            @{
                                var rolesDict = ViewBag.UserRoles as Dictionary<string, List<string>>;
                                var roles = rolesDict != null && rolesDict.ContainsKey(user.Id) ? rolesDict[user.Id] : new List<string>();
                            }

                            @foreach (var role in roles)
                            {
                                <span class="modern-badge @(role == "Admin" ? "badge-soft-danger" : "badge-soft-primary")"
                                      style="margin-right:4px;">
                                    @role
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-modern @(isLocked ? "btn-outline-info-modern" : "btn-outline-warning-modern")"
                                    onclick="toggleLockUser('@user.Id')">
                                @(isLocked ? "Mở khóa" : "Khóa tài khoản")
                            </button>
                        </td>
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-modern btn-outline-info-modern"
                                    onclick="goUpdateUser('@user.Id')" style="margin-right: 4px;">
                                Sửa
                            </button>
                            <button type="button"
                                    class="btn btn-modern btn-outline-danger-modern"
                                    onclick="goDeleteUser('@user.Id')">
                                Xóa
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (ViewBag.TotalPage > 1)
{
    int currentPage = ViewBag.CurrentPage;
    int totalPage = ViewBag.TotalPage;

    int startPage = currentPage - 2;
    int endPage = currentPage + 2;

    if (startPage < 1)
    {
        startPage = 1;
        endPage = Math.Min(5, totalPage);
    }

    if (endPage > totalPage)
    {
        endPage = totalPage;
        startPage = Math.Max(1, totalPage - 4);
    }

    <nav aria-label="Page navigation">
        <ul class="pagination modern-pagination">
            <li class="@(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a href="javascript:void(0)" onclick="loadUsers(@(ViewBag.CurrentPage - 1))">
                    &lt; Trước
                </a>
            </li>

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="@(i == ViewBag.CurrentPage ? "active" : "")">
                    <a href="javascript:void(0)" onclick="loadUsers(@i)">
                        @i
                    </a>
                </li>
            }

            <li class="@(ViewBag.CurrentPage == ViewBag.TotalPage ? "disabled" : "")">
                <a href="javascript:void(0)" onclick="loadUsers(@(ViewBag.CurrentPage + 1))">
                    Sau &gt;
                </a>
            </li>
        </ul>
    </nav>
}