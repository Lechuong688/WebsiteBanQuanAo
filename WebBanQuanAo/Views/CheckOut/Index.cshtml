@model WebBanQuanAo.Models.CheckOutViewModel
<!-- Checkout Page Start -->
<div class="container-fluid bg-light overflow-hidden py-5">
    <div class="container py-5">
        <h1 class="mb-4 wow fadeInUp" data-wow-delay="0.1s">Chi tiết thanh toán</h1>
        <form id="checkoutForm"
              asp-action="PlaceOrder"
              method="post">
            @foreach (var item in Model.SelectedItems)
            {
                <input type="hidden" name="SelectedItems" value="@item" />
            }
            <div class="row g-5">
                <div class="col-md-12 col-lg-6 col-xl-6 wow fadeInUp" data-wow-delay="0.1s">

                    <div class="form-item0">
                        <label>Họ và tên *</label>

                        @if (Model.IsAuthenticated)
                        {
                            <input name="FullName" class="form-control" value="@Model.FullName"  />
                        }
                        else
                        {
                            <input name="FullName" class="form-control"  />
                        }

                    </div>
                    <div class="row">
                        <div class="col-md-12 col-lg-7">
                            <div class="form-item w-100">
                                <label>Email *</label>

                                @if (Model.IsAuthenticated)
                                {
                                    <input name="Email" class="form-control" value="@Model.Email"  />
                                }
                                else
                                {
                                    <input name="Email" class="form-control"  />
                                }

                            </div>
                        </div>
                        <div class="col-md-12 col-lg-5">
                            <div class="form-item w-100">
                                <label>Số điện thoại *</label>

                                @if (Model.IsAuthenticated)
                                {
                                    <input name="PhoneNumber" class="form-control" value="@Model.PhoneNumber"  />
                                }
                                else
                                {
                                    <input name="PhoneNumber" class="form-control"  />
                                }

                            </div>
                        </div>
                    </div>
                    <div class="form-item mb-3">
                        <label>Tỉnh / Thành phố *</label>
                        <select id="province" class="form-control">
                            <option value="">-- Chọn tỉnh thành --</option>
                        </select>
                    </div>

                    <div class="form-item mb-3">
                        <label>Quận / Huyện *</label>
                        <select id="district" class="form-control">
                            <option value="">-- Chọn quận huyện --</option>
                        </select>
                    </div>

                    <div class="form-item mb-3">
                        <label>Phường / Xã *</label>
                        <select id="ward" class="form-control">
                            <option value="">-- Chọn phường xã --</option>
                        </select>
                    </div>

                    <div class="form-item mb-3">
                        <label>Địa chỉ chi tiết *</label>
                        <input id="detailAddress"
                               class="form-control"
                               placeholder="Số nhà, tên đường..." />
                    </div>

                    <input type="hidden"
                           name="Address"
                           id="fullAddress" />
                    
                    <hr>
                    <div class="form-item">
                        <label class="form-label my-3">Ghi chú đơn hàng</label>
                        <textarea name="Note" class="form-control" spellcheck="false" cols="30" rows="11" placeholder="Nhập ghi chú" >@Model.Note</textarea>
                    </div>
                    @if (!Model.IsAuthenticated)
                    {
                        <div class="form-check my-3">
                            @* <input type="checkbox" class="form-check-input" id="Account-1" name="Accounts" value="Accounts"> *@
                            <a href="Auth/Register" class="form-check" for="Account-1">Tạo tài khoản?</a>
                        </div>
                    }
                </div>
                <div class="col-md-12 col-lg-6 col-xl-6 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr class="text-center">
                                    <th scope="col" class="text-start">Tên sản phẩm</th>
                                    <th scope="col">Hình ảnh</th>
                                    <th scope="col">Màu sắc / Size</th>
                                    <th scope="col">Giá tiền</th>
                                    <th scope="col">Số lượng</th>
                                    <th scope="col">Tổng tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Cart.Items)
                                {
                                    <tr class="text-center">
                                        <th scope="row" class="text-start py-4">
                                            @item.ProductName
                                        </th>
                                        <td class="py-3">
                                            <img src="@item.ProductImage"
                                                 style="width:80px;
                                                        height:80px;
                                                        object-fit:cover;
                                                        border-radius:12px;
                                                        border:1px solid #eee;" />
                                                                            </td>
                                        <td class="py-4">
                                            @item.ColorName / @item.SizeName
                                        </td>
                                        <td class="py-4">
                                            @item.Price.ToString("N0") ₫
                                        </td>
                                        <td class="py-4 text-center">
                                            @item.Quantity
                                        </td>
                                        <td class="py-4">
                                            @((item.Price * item.Quantity).ToString("N0")) ₫
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <th scope="row">
                                    </th>
                                    <td colspan="2" class="py-4">
                                        <p class="mb-0 text-dark py-2">Tổng tiền sản phẩm</p>
                                    </td>
                                    <td colspan="3" class="py-4">
                                        <div class="py-2 text-center border-bottom border-top">
                                            <p class="mb-0 text-dark">
                                                @Model.Cart.SubTotal.ToString("N0") ₫
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">
                                    </th>
                                    <td colspan="2" class="py-1">
                                        <p class="mb-0 text-dark py-4">Tiền vận chuyển</p>
                                    </td>
                                    <td colspan="3" class="py-4">
                                        <div class="py-2 text-center border-bottom border-top">
                                        @if (Model.Cart.SubTotal >= 500000)
                                        {
                                            <p class="mb-0 text-dark">
                                                Miễn phí tiền vận chuyển
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="mb-0 text-dark">
                                                @Model.Cart.ShippingFee.ToString("N0") ₫
                                            </p>
                                        }
                                        </div>
                                    </td>
                                </tr>
                                
                                <tr>
                                    <th scope="row">
                                    </th>
                                    <td colspan="2" class="py-1">
                                        <p class="mb-0 text-dark py-5">Mã giảm giá</p>
                                    </td>
                                    <td colspan="3" class="py-4">
                                        <div class="py-2 text-center border-bottom border-top">
                                            <input name="DiscountCode" class="form-control" value="@Model.DiscountCode"/>
                                        </div>
                                        <button type="submit" name="action" value="apply" class="btn btn-sm btn-success mt-2">
                                            Áp dụng mã
                                        </button>
                                    </td>
                                </tr>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <tr>
                                        <th scope="row">
                                        </th>
                                        <td colspan="2" class="py-1">
                                            <p class="mb-0 text-danger py-4">Giảm giá</p>
                                        </td>
                                        <td colspan="3" class="py-4">
                                            <div class="py-2 text-center border-bottom border-top">
                                                <p class="mb-0 text-danger">
                                                    -@Model.DiscountAmount?.ToString("N0") đ
                                                </p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <th scope="row">
                                    </th>
                                    <td colspan="2" class="py-4">
                                        <p class="mb-0 text-dark text-uppercase py-2">Tổng đơn hàng</p>
                                    </td>
                                    <td colspan="3" class="py-4">
                                        <div class="py-2 text-center border-bottom border-top">
                                            @* <p class="mb-0 text-dark">
                                                @((Model.Cart.Total - Model.DiscountAmount)?.ToString("N0")) ₫
                                            </p> *@
                                            <p class="mb-0 text-dark">
                                                @Model.Cart.Total.ToString("N0") ₫
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="row g-4 text-center align-items-center justify-content-center border-bottom py-2">
                        <div class="col-12">
                            <div class="form-check text-start my-2">
                                <input type="radio" name="PaymentMethod" value="COD" checked />
                                <label>Thanh toán khi nhận hàng</label>
                            </div>

                            <div class="form-check text-start my-2">
                                <input type="radio" name="PaymentMethod" value="BANK" />
                                <label>Thanh toán bằng chuyển khoản (QR)</label>
                            </div>
                        </div>
                    </div>
                    <div class="row g-4 text-center align-items-center justify-content-center pt-4">
                        <label class="form-check-label" for="Delivery-1">Miễn phí vận chuyển cho đơn hàng có giá trị &#8805 500.000đ</label>
                        <button type="submit"
                                name="action"
                                value="order"
                                class="btn btn-primary border-secondary py-3 px-4 text-uppercase w-100 text-primary">
                            Đặt Hàng
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- Checkout Page End -->

<script>

    async function loadProvinces() {

        const response =
            await fetch('https://provinces.open-api.vn/api/p/');

        const data = await response.json();

        const province =
            document.getElementById('province');

        data.forEach(item => {

            province.innerHTML += `
                <option value="${item.code}">
                    ${item.name}
                </option>
            `;
        });
    }

    async function loadDistricts(provinceCode) {

        const response =
            await fetch(
                `https://provinces.open-api.vn/api/p/${provinceCode}?depth=2`
            );

        const data = await response.json();

        const district =
            document.getElementById('district');

        district.innerHTML =
            '<option value="">-- Chọn quận huyện --</option>';

        data.districts.forEach(item => {

            district.innerHTML += `
                <option value="${item.code}">
                    ${item.name}
                </option>
            `;
        });
    }

    async function loadWards(districtCode) {

        const response =
            await fetch(
                `https://provinces.open-api.vn/api/d/${districtCode}?depth=2`
            );

        const data = await response.json();

        const ward =
            document.getElementById('ward');

        ward.innerHTML =
            '<option value="">-- Chọn phường xã --</option>';

        data.wards.forEach(item => {

            ward.innerHTML += `
                <option value="${item.name}">
                    ${item.name}
                </option>
            `;
        });
    }

    document
        .getElementById('province')
        .addEventListener('change', function () {

            loadDistricts(this.value);
        });

    document
        .getElementById('district')
        .addEventListener('change', function () {

            loadWards(this.value);
        });

    document.getElementById('checkoutForm')
    .addEventListener('submit', function (e) {

        const provinceSelect =
            document.getElementById('province');

        const districtSelect =
            document.getElementById('district');

        const wardSelect =
            document.getElementById('ward');

        const detail =
            document.getElementById('detailAddress').value;

        const province =
            provinceSelect.options[
                provinceSelect.selectedIndex
            ]?.text || '';

        const district =
            districtSelect.options[
                districtSelect.selectedIndex
            ]?.text || '';

        const ward =
            wardSelect.options[
                wardSelect.selectedIndex
            ]?.text || '';

        const fullAddress =
            `${detail}, ${ward}, ${district}, ${province}`;

        console.log(fullAddress);

        document.getElementById('fullAddress').value =
            fullAddress;
    });

    loadProvinces();

</script>