@{
    ViewData["Title"] = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid order-success-section wow fadeInUp" data-wow-delay="0.1s" style="background: linear-gradient(to bottom, #f8f9fa, #e9ecef);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="success-card text-center p-5 bg-white rounded-3 shadow-lg border-top border-5 border-success position-relative overflow-hidden">

                    <div class="bg-decoration"></div>

                    <div class="checkmark-wrapper mb-4">
                        <div class="checkmark-circle">
                            <svg class="checkmark-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                                <circle class="checkmark-circle-stroke" cx="26" cy="26" r="25" fill="none" />
                                <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
                            </svg>
                        </div>
                    </div>

                    <h2 class="success-title fw-bold mb-3 text-dark">Thanh toán thành công!</h2>

                    <p class="success-text text-muted mb-4">
                        Cảm ơn bạn đã lựa chọn <strong>VYBE</strong>.<br>
                        Đơn hàng của bạn đã được tiếp nhận.
                    </p>

                    <div class="order-summary bg-light p-3 rounded mb-4 border border-1 border-light">
                        <p class="mb-1 text-uppercase text-secondary small fw-bold">Mã đơn hàng</p>
                        <h4 class="mb-0 text-primary fw-bold">#VYBE @ViewBag.OrderId</h4>
                        <small class="text-muted">Kiểm tra email để xem chi tiết</small>
                    </div>

                    <div class="d-flex justify-content-center gap-3 flex-column flex-sm-row">
                        <a href="/" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                            <i class="fa fa-home me-2"></i>Về trang chủ
                        </a>

                        <a href="/Order/History" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                            Xem đơn hàng
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>