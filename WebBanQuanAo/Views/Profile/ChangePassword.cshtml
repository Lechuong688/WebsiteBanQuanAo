@model Data.DTO.User.ChangePasswordDTO

<div class="container py-5">

    <div class="row">

        <!-- SIDEBAR -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <div class="text-center">

                    <img src="/uploads/Users/avatar-trang-4.jpg"
                         class="rounded-circle shadow"
                         style="width:140px;
                                height:140px;
                                object-fit:cover;" />

                    <h4 class="mt-3">
                        Tài khoản của tôi
                    </h4>

                    <p class="text-muted">
                        Quản lý thông tin cá nhân
                    </p>

                </div>

                <hr />

                <div class="list-group border-0">

                    <a href="/Profile/Index"
                       class="list-group-item list-group-item-action border-0">
                        👤 Hồ sơ cá nhân
                    </a>

                    <a href="/Profile/ChangePassword"
                       class="list-group-item list-group-item-action border-0 active">
                        🔒 Đổi mật khẩu
                    </a>

                    <a href="/Order/History"
                       class="list-group-item list-group-item-action border-0">
                        📦 Đơn hàng
                    </a>

                    <a href="/Product/ProductWishlist"
                       class="list-group-item list-group-item-action border-0">
                        ❤️ Wishlist
                    </a>

                </div>

            </div>

        </div>

        <!-- CONTENT -->
        <div class="col-md-9">

            <div class="card shadow-sm border-0 rounded-4 p-5">

                <h3 class="mb-4">
                    Đổi mật khẩu
                </h3>

                @if (TempData["success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["success"]
                    </div>
                }

                @if (TempData["error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["error"]
                    </div>
                }

                <form asp-action="ChangePassword"
                      method="post">

                    <div class="mb-3">

                        <label class="form-label">
                            Mật khẩu hiện tại
                        </label>

                        <input asp-for="CurrentPassword"
                               type="password"
                               class="form-control form-control-lg" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Mật khẩu mới
                        </label>

                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control form-control-lg" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Xác nhận mật khẩu
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control form-control-lg" />

                    </div>

                    <button class="btn btn-dark btn-lg rounded-pill px-5">
                        Đổi mật khẩu
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>