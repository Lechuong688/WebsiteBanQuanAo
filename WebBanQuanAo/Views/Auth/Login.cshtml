@{
    Layout = "_AuthLayout";
}

<style>
    .login-wrapper {
        background-image: url('/uploads/nendangnhap.webp');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        width: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

        .login-wrapper::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: inherit;
            filter: blur(15px);
            transform: scale(1.1);
            z-index: 0;
        }

    .glass-card {
        z-index: 1;
        background: rgba(255, 255, 255, 0.9) !important;
        border-radius: 15px;
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .divider-text {
        position: relative;
        text-align: center;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
    }

        .divider-text::before, .divider-text::after {
            content: "";
            position: absolute;
            top: 50%;
            width: 35%;
            height: 1px;
            background-color: #dee2e6;
        }

        .divider-text::before {
            left: 0;
        }

        .divider-text::after {
            right: 0;
        }
</style>

<div class="login-wrapper">
    <div class="card glass-card shadow p-4" style="width: 420px; border: none;">
        <h4 class="text-center mb-4">Trang đăng nhập</h4>

        <form method="post" autocomplete="off">
            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                <input name="username"
                       type="text"
                       class="form-control"
                       placeholder="Tên đăng nhập">
            </div>

            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <input name="password"
                       type="password"
                       class="form-control"
                       placeholder="Mật khẩu">
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="remember">
                    <label class="form-check-label" for="remember">
                        Nhớ mật khẩu
                    </label>
                </div>

                <a asp-controller="Auth"
                   asp-action="ForgotPassword"
                   class="text-decoration-none small">
                    Quên mật khẩu?
                </a>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="text-danger mb-3 text-center">
                    @ViewBag.Error
                </div>
            }

            <div class="d-flex justify-content-between mb-3">
                <button type="reset" class="btn btn-outline-secondary" style="width: 48%;">
                    Thoát
                </button>
                <button type="submit" class="btn btn-dark" style="width: 48%;">
                    Đăng nhập
                </button>
            </div>

            <div class="divider-text">
                <span class="text-muted small px-2 bg-transparent">Hoặc đăng nhập với</span>
            </div>

            <div class="d-grid gap-2">
                <a asp-controller="Auth"
                   asp-action="GoogleLogin" class="btn btn-outline-danger d-flex justify-content-center align-items-center">

                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google me-2" viewBox="0 0 16 16">
                        <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z" />
                    </svg>
                    Google
                </a>
                <a asp-controller="Auth"
                   asp-action="FacebookLogin" class="btn btn-outline-primary d-flex justify-content-center align-items-center">

                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-facebook me-2" viewBox="0 0 16 16">
                        <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z" />
                    </svg>
                    Facebook
                </a>
            </div>
            <div class="text-center mt-3">
                <span class="text-muted small">Bạn chưa có tài khoản? <a href="/Auth/Register" class="text-dark fw-bold text-decoration-none">Đăng ký</a></span>
            </div>
        </form>
    </div>
</div>