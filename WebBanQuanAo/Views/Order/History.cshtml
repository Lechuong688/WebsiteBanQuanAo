@model List<Data.DTO.Order.OrderHistoryDTO>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user/historyorder.css" />
}

<div class="history-page-wrapper">
<div class="container py-4">
    <ul class="nav order-tabs mb-4" id="orderTabs">
        <li class="nav-item"><button class="nav-link active filter-tab" data-status="all">Tất cả</button></li>
        <li class="nav-item"><button class="nav-link filter-tab" data-status="0">Chờ thanh toán</button></li>
        <li class="nav-item"><button class="nav-link filter-tab" data-status="1">Chờ giao hàng</button></li>
        <li class="nav-item"><button class="nav-link filter-tab" data-status="2">Đang giao</button></li>
        <li class="nav-item"><button class="nav-link filter-tab" data-status="3">Hoàn thành</button></li>
        <li class="nav-item"><button class="nav-link filter-tab" data-status="4">Đã hủy</button></li>
    </ul>

    <div id="orderListContainer">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 text-muted bg-white rounded shadow-sm">
                <i class="fas fa-clipboard-list fa-4x mb-3 text-light"></i>
                <h5 class="fw-normal">Chưa có đơn hàng</h5>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                // Xác định Text và Màu sắc cho trạng thái
                string statusText = "";
                string statusClass = "text-primary";

                switch (order.Status)
                {
                    case 0: statusText = "CHỜ THANH TOÁN"; statusClass = "text-warning"; break;
                    case 1: statusText = "CHỜ GIAO HÀNG"; statusClass = "text-info"; break;
                    case 2: statusText = "ĐANG VẬN CHUYỂN"; statusClass = "text-primary"; break;
                    case 3: statusText = "HOÀN THÀNH"; statusClass = "text-success"; break;
                    case 4: statusText = "ĐÃ HỦY"; statusClass = "text-danger"; break;
                    default: statusText = "KHÔNG XÁC ĐỊNH"; break;
                }

                <div class="order-card order-item-card" data-status="@order.Status">
                    <div class="order-header">
                        <div>
                            <span class="shop-badge">VYBE</span>
                            <strong>Mã ĐH: @order.TransactionCode</strong>
                        </div>
                        <div class="d-flex align-items-center">
                            @if (order.Status == 3)
                            {
                                <span class="text-success me-3 small"><i class="fas fa-truck"></i> Đơn hàng đã được giao thành công</span>
                            }
                            <span class="order-status-text @statusClass">@statusText</span>
                        </div>
                    </div>

                    @foreach (var detail in order.Details)
                    {
                        <div class="order-body">
                            <img src="@(!string.IsNullOrEmpty(detail.Image) ? detail.Image : "/admin/img/no-image.png")" class="order-item-img" alt="Product">

                            <div class="order-item-info">
                                <div class="order-item-name">@detail.ProductName</div>
                                <div class="order-item-variant">
                                    Màu sắc: <strong>@detail.ColorName</strong>, Kích thước: <strong>@detail.SizeName</strong>
                                </div>
                                <div class="fw-bold text-muted">x@(detail.Quantity)</div>
                            </div>

                            <div class="order-item-price d-flex align-items-center justify-content-end">
                                <span class="text-primary fw-bold" style="color: var(--vybe-orange) !important;">
                                    @detail.Price.ToString("N0")₫
                                </span>
                            </div>
                        </div>
                    }

                    <div class="order-footer">
                        <div class="total-price-section">
                            <span class="text-dark">Thành tiền:</span>
                            <span class="total-price-number">@order.Total.ToString("N0")₫</span>
                        </div>
                        <div class="action-buttons">
                            <span class="action-note">Ngày đặt: @order.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                            <div class="d-flex gap-2">
                                @if (order.Status == 0)
                                {
                                    <a href="/Order/Payment/@order.Id" class="btn btn-action-main">Thanh toán ngay</a>
                                    <button class="btn btn-action-sub">Hủy đơn hàng</button>
                                }
                                    @if (order.Status == 0)
                                    {
                                        <a href="/Order/Payment/@order.Id" class="btn btn-action-main">Thanh toán ngay</a>
                                        <button class="btn btn-action-sub">Hủy đơn hàng</button>
                                    }
                                    else if (order.Status == 1 || order.Status == 2)
                                    {
                                        @if (order.Status == 1)
                                        {
                                            <button class="btn btn-action-disabled" disabled>Đã nhận được hàng</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-action-main" onclick="confirmReceived(@order.Id)">Đã nhận được hàng</button>
                                        }
                                        <button class="btn btn-action-sub">Liên hệ Shop</button>
                                    }
                                    else if (order.Status == 3)
                                    {
                                        <button class="btn btn-action-main">Đánh giá</button>

                                        @if (order.Details.Any())
                                        {
                                            var firstItem = order.Details.First();
                                            <a href="/Product/Detail/@firstItem.ProductId" class="btn btn-action-sub">Mua lại</a>
                                        }
                                    }
                                    else
                                    {
                                        <button class="btn btn-action-sub">Xem chi tiết</button>
                                    }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            // Xử lý chuyển Tab lọc trạng thái
            $('.filter-tab').click(function () {
                // Đổi UI của tab
                $('.filter-tab').removeClass('active');
                $(this).addClass('active');

                // Lấy status cần lọc
                var targetStatus = $(this).data('status');

                // Ẩn/Hiện card đơn hàng
                if (targetStatus === 'all') {
                    $('.order-item-card').removeClass('d-none');
                } else {
                    $('.order-item-card').each(function () {
                        // So sánh data-status của card với tab đang chọn
                        if ($(this).data('status') == targetStatus) {
                            $(this).removeClass('d-none');
                        } else {
                            $(this).addClass('d-none');
                        }
                    });
                }
            });
        });
    </script>
}