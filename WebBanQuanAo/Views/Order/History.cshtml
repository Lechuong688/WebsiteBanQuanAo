@model List<Data.DTO.Order.OrderHistoryDTO>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user/historyorder.css" />
}

<div class="history-page-wrapper">
    <div class="container py-4">
        <ul class="nav order-tabs mb-4" id="orderTabs">
            <li class="nav-item"><button class="nav-link active filter-tab" data-status="all">Tất cả</button></li>
            <li class="nav-item"><button class="nav-link filter-tab" data-status="0">Chờ thanh toán</button></li>
            <li class="nav-item"><button class="nav-link filter-tab" data-status="1">Chờ giao hàng</button></li>
            <li class="nav-item"><button class="nav-link filter-tab" data-status="2">Đang giao</button></li>
            <li class="nav-item"><button class="nav-link filter-tab" data-status="3">Hoàn thành</button></li>
            <li class="nav-item"><button class="nav-link filter-tab" data-status="4">Đã hủy</button></li>
        </ul>

        <div id="orderListContainer">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 text-muted bg-white rounded shadow-sm">
                    <i class="fas fa-clipboard-list fa-4x mb-3 text-light"></i>
                    <h5 class="fw-normal">Chưa có đơn hàng</h5>
                </div>
            }
            else
            {
                @foreach (var order in Model)
                {
                    // Xác định Text và Màu sắc cho trạng thái
                    string statusText = "";
                    string statusClass = "text-primary";

                    switch (order.Status)
                    {
                        case 0: statusText = "CHỜ THANH TOÁN"; statusClass = "text-warning"; break;
                        case 1: statusText = "CHỜ GIAO HÀNG"; statusClass = "text-info"; break;
                        case 2: statusText = "ĐANG VẬN CHUYỂN"; statusClass = "text-primary"; break;
                        case 3: statusText = "HOÀN THÀNH"; statusClass = "text-success"; break;
                        case 4: statusText = "ĐÃ HỦY"; statusClass = "text-danger"; break;
                        default: statusText = "KHÔNG XÁC ĐỊNH"; break;
                    }

                    <div class="order-card order-item-card" data-status="@order.Status">
                        <div class="order-header">
                            <div>
                                <span class="shop-badge">VYBE</span>
                                <strong>Mã ĐH: @order.TransactionCode</strong>
                            </div>
                            <div class="d-flex align-items-center">
                                @if (order.Status == 3)
                                {
                                    <span class="text-success me-3 small"><i class="fas fa-truck"></i> Đơn hàng đã được giao thành công</span>
                                }
                                <span class="order-status-text @statusClass">@statusText</span>
                            </div>
                        </div>

                        @foreach (var detail in order.Details)
                        {
                            <div class="order-body">
                                <img src="@(!string.IsNullOrEmpty(detail.Image) ? detail.Image : "/admin/img/no-image.png")" class="order-item-img" alt="Product">

                                <div class="order-item-info">
                                    <div class="order-item-name">@detail.ProductName</div>

                                    <div class="order-item-variant">
                                        Màu sắc: <strong>@detail.ColorName</strong>,
                                        Kích thước: <strong>@detail.SizeName</strong>
                                    </div>

                                    <div class="fw-bold text-muted">
                                        x@(detail.Quantity)
                                    </div>
                                </div>

                                <div class="order-item-price d-flex align-items-center justify-content-end">
                                    <span class="text-primary fw-bold" style="color: var(--vybe-orange) !important;">
                                        @detail.Price.ToString("N0")₫
                                    </span>
                                </div>
                            </div>
                        }

                        <div class="order-footer">
                            <div class="total-price-section">
                                <span class="text-dark">Thành tiền:</span>
                                <span class="total-price-number">@order.Total.ToString("N0")₫</span>
                            </div>
                            <div class="action-buttons">
                                <span class="action-note">Ngày đặt: @order.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                <div class="d-flex gap-2">
                                    @if (order.Status == 0)
                                    {
                                        <a href="/Order/Payment/@order.Id" class="btn btn-action-main">Thanh toán ngay</a>
                                        <button class="btn btn-action-sub"
                                                onclick="cancelOrder(@order.Id)">
                                            Hủy đơn hàng
                                        </button>
                                    }
                                    else if (order.Status == 1 || order.Status == 2)
                                    {
                                        @if (order.Status == 1)
                                        {
                                            <button class="btn btn-action-disabled" disabled>Đã nhận được hàng</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-action-main" onclick="confirmReceived(@order.Id)">Đã nhận được hàng</button>
                                        }
                                        <button class="btn btn-action-sub">Liên hệ Shop</button>
                                    }
                                    else if (order.Status == 3)
                                    {
                                        <button class="btn btn-action-main"
                                                onclick='openReviewModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(order)))'>

                                            Đánh giá

                                        </button>

                                        @if (order.Details.Any())
                                        {
                                            var firstItem = order.Details.First();

                                            <a href="/Product/Detail/@firstItem.ProductId"
                                               class="btn btn-action-sub">

                                                Mua lại

                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        @if (order.Details.Any())
                                        {
                                            var firstItem = order.Details.First();

                                            <a href="/Product/Detail/@firstItem.ProductId"
                                               class="btn btn-action-sub">

                                                Xem chi tiết

                                            </a>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
<div class="modal fade"
     id="reviewModal"
     tabindex="-1">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Đánh giá sản phẩm
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="review-order-id" />

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Đánh giá chung
                    </label>

                    <select id="review-rating"
                            class="form-select">

                        <option value="5">⭐⭐⭐⭐⭐</option>
                        <option value="4">⭐⭐⭐⭐</option>
                        <option value="3">⭐⭐⭐</option>
                        <option value="2">⭐⭐</option>
                        <option value="1">⭐</option>

                    </select>
                </div>

                <div class="mb-3">

                    <div class="mt-3">

                        <label class="form-label fw-bold">
                            Bình luận đánh giá
                        </label>

                        <textarea id="review-comment"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Hãy chia sẻ cảm nhận của bạn về sản phẩm">
                        </textarea>

                    </div>

                    <div class="mt-3">

                        <label class="form-label fw-bold">
                            Hình ảnh đánh giá
                        </label>

                        <input type="file"
                               id="review-images"
                               class="form-control"
                               multiple
                               accept="image/*">

                    </div>

                    <div id="review-preview"
                         class="d-flex gap-2 flex-wrap mt-3">
                    </div>

                </div>

                <hr />

                <div id="review-product-list"></div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Đóng
                </button>

                <button type="button"
                        class="btn btn-dark"
                        onclick="submitReview()">
                    Gửi đánh giá
                </button>

            </div>

        </div>
    </div>
</div>
@section Scripts {
    <script>

        $(document).ready(function () {

            $('.filter-tab').click(function () {

                $('.filter-tab').removeClass('active');

                $(this).addClass('active');

                var targetStatus = $(this).data('status');

                if (targetStatus === 'all') {

                    $('.order-item-card').removeClass('d-none');
                }
                else {

                    $('.order-item-card').each(function () {

                        if ($(this).data('status') == targetStatus) {

                            $(this).removeClass('d-none');
                        }
                        else {

                            $(this).addClass('d-none');
                        }
                    });
                }
            });
        });


        let currentReviewOrder = null;

        function openReviewModal(order) {

            currentReviewOrder = order;

            $('#review-comment').val('');

            $('#review-images').val('');

            $('#review-preview').html('');

            $('#review-rating').val('5');

            $('#review-order-id').val(order.Id);

            let html = '';

            order.Details.forEach(detail => {

                html += `
                    <div class="d-flex align-items-center mb-2">

                        <i class="fas fa-box me-2 text-muted"></i>

                        <span>
                            ${detail.ProductName}
                        </span>

                    </div>
                `;
            });

            $('#review-product-list').html(html);

            $('#reviewModal').modal('show');
        }


        $(document).on('change', '#review-images', function () {

            $('#review-preview').html('');

            const files = this.files;

            for (const file of files) {

                const reader = new FileReader();

                reader.onload = function (e) {

                    $('#review-preview').append(`
                        <img src="${e.target.result}"
                             width="80"
                             height="80"
                             class="rounded border"
                             style="object-fit:cover">
                    `);
                };

                reader.readAsDataURL(file);
            }
        });


        async function submitReview() {

            try {

                if (!currentReviewOrder) {

                    alert('Không tìm thấy đơn hàng');

                    return;
                }

                const rating = $('#review-rating').val();

                const comment = $('#review-comment').val();

                let imagePaths = [];


                const files = $('#review-images')[0].files;

                if (files.length > 0) {

                    const formData = new FormData();

                    for (const file of files) {

                        formData.append('files', file);
                    }

                    const uploadResponse = await fetch('/ProductReview/UploadImages', {

                        method: 'POST',

                        body: formData
                    });

                    const uploadText = await uploadResponse.text();

                    console.log(uploadText);

                    if (!uploadResponse.ok) {

                        alert(uploadText);

                        return;
                    }

                    imagePaths = JSON.parse(uploadText);
                }


                for (const detail of currentReviewOrder.Details) {

                    const dto = {

                        orderId: currentReviewOrder.Id,

                        productId: detail.ProductId,

                        rating: rating,

                        comment: comment,

                        imagePaths: imagePaths
                    };

                    const response = await fetch('/ProductReview/Create', {

                        method: 'POST',

                        headers: {
                            'Content-Type': 'application/json'
                        },

                        body: JSON.stringify(dto)
                    });

                    const result = await response.json();

                    console.log(result);
                }

                alert('Đánh giá thành công');

                $('#reviewModal').modal('hide');

                $('#review-comment').val('');

                $('#review-images').val('');

                $('#review-preview').html('');

                $('#review-rating').val('5');

            }
            catch (error) {

                console.log(error);

                alert(error);
            }
        }

                async function cancelOrder(orderId) {

            const confirmCancel =
                confirm("Bạn có chắc muốn hủy đơn hàng này không?");

            if (!confirmCancel)
                return;

            try {

                const response = await fetch('/Order/CancelOrder', {

                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify(orderId)
                });

                const result = await response.json();

                if (result.success) {

                    alert("✅ Hủy đơn hàng thành công");

                    location.reload();
                }
                else {

                    alert(result.message);
                }
            }
            catch {

                alert("⚠️ Có lỗi xảy ra");
            }
        }
    </script>
}