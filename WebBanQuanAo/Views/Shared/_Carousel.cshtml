@using Data.DTO.Banner
@using Data.DTO.Product
@{
    var banners = ViewBag.Banners as List<BannerListDTO>;
    var pinned = ViewBag.PinnedProduct as ProductListDTO;
}
<div class="container-fluid carousel bg-light px-0">
    <div class="row g-0 justify-content-end">
        <div class="col-12 col-lg-7 col-xl-9">
            <div class="header-carousel owl-carousel bg-light py-5">

                @if (banners != null && banners.Any())
                {
                    foreach (var banner in banners)
                    {
                        <div class="row g-0 header-carousel-item align-items-center">

                            <div class="col-xl-6 carousel-img">
                                <img src="@banner.ImagePath"
                                     class="img-fluid w-65"
                                     alt="@banner.Title">
                            </div>

                            <div class="col-xl-6 carousel-content p-4">
                                <h4 class="text-uppercase fw-bold mb-4">
                                    @banner.SubTitle
                                </h4>

                                <h1 class="display-3 mb-4">
                                    @banner.Title
                                </h1>

                                <h4 class="text-dark wow fadeInRight">
                                    @banner.Description
                                </h4>

                                <a class="btn btn-primary rounded-pill py-3 px-5"
                                   href="/bo-suu-tap/@banner.Code">
                                    @banner.ButtonText
                                </a>
                            </div>

                        </div>
                    }
                }

            </div>
        </div>
        <div class="col-12 col-lg-5 col-xl-3 wow fadeInRight" data-wow-delay="0.1s">
            <div class="carousel-header-banner h-100">
                @if (pinned != null && pinned.Files != null && pinned.Files.Any())
                {
                    <img src="@pinned.Files.FirstOrDefault()"
                         class="img-fluid w-100 h-100"
                         style="object-fit: cover;"
                         alt="@pinned.Name">
                }
                <div class="carousel-banner-offer">
                    <p class="bg-primary text-white rounded fs-5 py-2 px-4 mb-0 me-3">
                        HOT
                    </p>

                    <p class="text-primary fs-5 fw-bold mb-0">
                        Sản phẩm nổi bật
                    </p>
                </div>
                <div class="carousel-banner">
                    @if (pinned != null)
                    {
                        <div class="carousel-banner-content text-center p-4">

                            <a href="/Product/Detail/@pinned.Id" class="d-block mb-2" style="font-weight: bold">
                                Sản phẩm nổi bật
                            </a>

                            <a href="/Product/Detail/@pinned.Id" class="d-block text-white fs-3" style="font-weight: bold">
                                @pinned.Name
                            </a>

                            @if (pinned.DiscountPercent.HasValue && pinned.DiscountPercent > 0)
                            {
                                <div>
                                    <span class="text-white text-decoration-line-through me-2">
                                        @pinned.Price.ToString("N0") ₫
                                    </span>

                                    <span class="text-primary fs-5 fw-bold">
                                        @pinned.FinalPrice.ToString("N0") ₫
                                    </span>
                                </div>

                                <span class="badge bg-danger">
                                    -@pinned.DiscountPercent%
                                </span>
                            }
                            else
                            {
                                <span class="text-primary fs-5">
                                    @pinned.Price.ToString("N0") ₫
                                </span>
                            }

                        </div>

                        <a href="/Product/Detail/@pinned.Id"
                           class="btn btn-primary rounded-pill py-2 px-4">
                            <i class="fas fa-shopping-cart me-2"></i>
                            Xem sản phẩm
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>