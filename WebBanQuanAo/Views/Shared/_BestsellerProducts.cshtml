@using Data.DTO.Product
@{
    var bestSeller = ViewBag.BestSeller as List<ProductBestsellerDTO>;
}
<div class="container-fluid products pb-5">
    <div class="container products-mini py-5">
        <div class="mx-auto text-center mb-5" style="max-width: 700px;">
            <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius wow fadeInUp" data-wow-delay="0.1s">Top sản phẩm bán chạy nhất</h4>
            <p class="mb-0 wow fadeInUp" data-wow-delay="0.2s">
                🔥 Best Seller tại VYBE!
                Sản phẩm đang “cháy hàng” với số lượng bán ra cực khủng. Không chỉ sở hữu thiết kế ấn tượng, mà còn đảm bảo chất lượng và trải nghiệm vượt mong đợi. Nếu bạn đang phân vân, đây chính là lựa chọn an toàn nhất!
            </p>
        </div>
        <div class="row g-4">
            @if (bestSeller != null && bestSeller.Any())
            {
                @foreach (var item in bestSeller)
                {
                    <div class="col-md-6 col-lg-6 col-xl-4 wow fadeInUp" data-wow-delay="0.1s">
                        <div class="products-mini-item border">
                            <div class="row g-0">
                                @* Cột chứa ảnh *@
                                <div class="col-5">
                                    <div class="products-mini-img border-end h-100" style="position: relative;">

                                        @if (item.DiscountPercent.HasValue && item.DiscountPercent > 0)
                                        {
                                            <div class="badge bg-danger position-absolute"
                                                 style="top: 5px; left: 5px; z-index: 10; font-size: 0.8rem; padding: 4px 8px;">
                                                -@item.DiscountPercent%
                                            </div>
                                        }

                                        <img src="@item.Files" class="img-fluid w-100 h-100" alt="@item.Name" onerror="this.src='/img/default-product.png'">

                                        <div class="products-mini-icon rounded-circle bg-primary">
                                            <a href="/Product/Detail/@item.Id"><i class="fa fa-eye fa-1x text-white"></i></a>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-7">
                                    <div class="products-mini-content p-3">
                                        <a href="#" class="d-block mb-2 text-muted">@item.TypeName</a>
                                        <a href="/Product/Detail/@item.Id" class="d-block h6 text-dark fw-bold">@item.Name</a>

                                        @if (item.DiscountPercent.HasValue && item.DiscountPercent > 0)
                                        {
                                            <del class="me-2 text-muted">@item.Price.ToString("N0") ₫</del>
                                            <span class="text-primary fw-bold">@item.FinalPrice.ToString("N0") ₫</span>
                                        }
                                        else
                                        {
                                            <span class="text-primary fw-bold">@item.Price.ToString("N0") ₫</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            @* Nút Thêm vào giỏ *@
                            <div class="products-mini-add border-top p-3">
                                <div class="d-flex align-items-center justify-content-between">
                                    <a href="/Product/Detail/@item.Id" class="btn btn-primary btn-sm rounded-pill px-3">
                                        <i class="fas fa-shopping-cart me-1"></i> Mua ngay
                                    </a>
                                    <div class="d-flex">
                                        <a href="#" class="text-primary me-2"><i class="fas fa-random"></i></a>
                                        <a href="#" class="text-primary"><i class="fas fa-heart"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">Không có sản phẩm bán chạy nào.</p>
                </div>
            }
        </div>
    </div>
</div>