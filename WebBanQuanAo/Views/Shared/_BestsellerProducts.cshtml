@using Data.DTO.Product
@{
    var bestSeller = ViewBag.BestSeller as List<ProductListDTO>;
}
<div class="container-fluid products pb-5">
    <div class="container products-mini py-5">
        <div class="mx-auto text-center mb-5" style="max-width: 700px;">
            <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius wow fadeInUp" data-wow-delay="0.1s">Bestseller Products</h4>
            <p class="mb-0 wow fadeInUp" data-wow-delay="0.2s">Lorem ipsum dolor sit amet consectetur adipisicing elit. Modi, asperiores ducimus sint quos tempore officia similique quia? Libero, pariatur consectetur?</p>
        </div>
        <div class="row g-4">
            @if (bestSeller != null && bestSeller.Any())
            {
                foreach (var item in bestSeller)
                {
                    <div class="col-md-6 col-lg-4 col-xl-3">

                        <div class="product-item rounded wow fadeInUp">

                            <a asp-controller="Product"
                               asp-action="Detail"
                               asp-route-id="@item.Id"
                               class="text-decoration-none text-dark">

                                <div class="product-item-inner border rounded">

                                    <div class="product-item-inner-item">

                                        @if (item.Files != null && item.Files.Any())
                                        {
                                            <img src="@item.Files.First()" class="img-fluid w-100 rounded-top">
                                        }
                                        else
                                        {
                                            <img src="~/img/no-image.png" class="img-fluid w-100 rounded-top">
                                        }

                                    </div>

                                    <div class="text-center rounded-bottom p-4">

                                        <span class="d-block mb-2">@item.TypeName</span>
                                        <span class="d-block h4">@item.Name</span>

                                        @if (item.DiscountPercent.HasValue && item.DiscountPercent > 0)
                                        {
                                            <div>
                                                <span class="text-muted text-decoration-line-through me-2">
                                                    @item.Price.ToString("N0") ₫
                                                </span>

                                                <span class="text-primary fs-5 fw-bold">
                                                    @item.FinalPrice.ToString("N0") ₫
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-primary fs-5">
                                                @item.Price.ToString("N0") ₫
                                            </span>
                                        }

                                    </div>
                                </div>

                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="text-center">
                    <p>Không có sản phẩm bán chạy.</p>
                </div>
            }
        </div>
    </div>
</div>