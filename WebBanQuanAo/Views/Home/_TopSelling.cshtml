@using Data.DTO.Product
@{
    var topSelling = ViewBag.TopSelling as List<ProductTopSellingDTO>;
}

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4 col-xl-3">
            <div class="product-item rounded wow fadeInUp" data-wow-delay="0.1s">
                <a asp-controller="Product"
                   asp-action="Detail"
                   asp-route-id="@item.Id"
                   class="text-decoration-none text-dark">

                    <div class="product-item-inner border rounded">
                        <div class="product-item-inner-item">
                            @if (!string.IsNullOrEmpty(item.Files))
                            {
                                <img src="@item.Files" class="img-fluid w-100 rounded-top" alt="">
                            }

                            @if (item.DiscountPercent > 0)
                            {
                                <div class="badge bg-danger position-absolute"
                                     style="top: 20px; left: 20px; z-index: 10; font-size: 0.8rem; padding: 8px 8px;">
                                    -@item.DiscountPercent%
                                </div>
                            }
                            @if (item.CreatedDate >= DateTime.Now.AddDays(-15))
                            {
                                <div class="product-new">New</div>
                            }

                            <div class="product-details">
                                <span><i class="fa fa-eye fa-1x"></i></span>
                            </div>

                        </div>

                        <div class="text-center rounded-bottom p-4">
                            <span class="d-block mb-2">@item.TypeName</span>
                            <span class="d-block h4">@item.Name</span>

                            @if (item.DiscountPercent > 0)
                            {
                                <div>
                                    <span class="text-muted text-decoration-line-through me-2">
                                        @item.Price.ToString("N0") ₫
                                    </span>

                                    <span class="text-primary fs-5 fw-bold">
                                        @item.FinalPrice.ToString("N0") ₫
                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="text-primary fs-5">
                                    @item.Price.ToString("N0") ₫
                                </span>
                            }
                        </div>
                    </div>
                </a>
                <div class="product-item-add border border-top-0 rounded-bottom text-center p-4 pt-0">
                    <a asp-controller="Product"
                       asp-action="Detail"
                       asp-route-id="@item.Id" class="btn btn-primary border-secondary rounded-pill py-2 px-4 mb-4"><i class="fas fa-shopping-cart me-2"></i> Add To Cart</a>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex">
                            <i class="fas fa-star text-primary"></i>
                            <i class="fas fa-star text-primary"></i>
                            <i class="fas fa-star text-primary"></i>
                            <i class="fas fa-star text-primary"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <div class="d-flex">
                            <a href="#" class="text-primary d-flex align-items-center justify-content-center me-3"><span class="rounded-circle btn-sm-square border"><i class="fas fa-random"></i></span></a>
                            <a href="#" class="text-primary d-flex align-items-center justify-content-center me-0"><span class="rounded-circle btn-sm-square border"><i class="fas fa-heart"></i></span></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>