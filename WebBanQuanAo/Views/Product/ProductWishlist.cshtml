@using Data.DTO
@using Data.DTO.Product
@model IEnumerable<ProductWishlistDTO>
@if (!Model.Any())
{
    <div class="alert alert-info">
        Danh sách sản phẩm yêu thích của bạn đang trống
    </div>
}
else
{
    <div class="container-fluid product py-5">
        <div class="container py-5">
            <div class="tab-class">
                <div class="text-start wow fadeInLeft" data-wow-delay="0.1s">
                    <h1>Danh sách sản phẩm yêu thích</h1>
                </div>
                <br/>
                <div class="tab-content">
                    <div id="tab-1" class="tab-pane fade show p-0 active">
                        <div class="row g-4">
                            @foreach (var item in Model)
                            {
                                <div class="col-md-6 col-lg-4 col-xl-3">
                                    <div class="product-item rounded wow fadeInUp" data-wow-delay="0.1s">
                                        <a asp-controller="Product"
                                           asp-action="Detail"
                                           asp-route-id="@item.Id"
                                           class="text-decoration-none text-dark">

                                            <div class="product-item-inner border rounded">
                                                <div class="product-item-inner-item">
                                                    @if (item.Files?.Count > 0)
                                                    {
                                                        <img src="@item.Files.FirstOrDefault()"
                                                             class="img-fluid w-100 rounded-top"
                                                             alt="">
                                                    }

                                                    @if (item.DiscountPercent > 0)
                                                    {
                                                        <div class="badge bg-danger position-absolute"
                                                             style="top: 20px; left: 20px; z-index: 10; font-size: 0.8rem; padding: 8px 8px;">
                                                            -@item.DiscountPercent%
                                                        </div>
                                                    }
                                                    @if (item.CreatedDate >= DateTime.Now.AddDays(-15))
                                                    {
                                                        <div class="product-new">New</div>
                                                    }

                                                    <div class="product-details">
                                                        <span><i class="fa fa-eye fa-1x"></i></span>
                                                    </div>

                                                </div>

                                                <div class="text-center rounded-bottom p-4">
                                                    <span class="d-block mb-2">@item.TypeName</span>
                                                    <span class="d-block h4">@item.Name</span>

                                                    @if (item.DiscountPercent.HasValue && item.DiscountPercent > 0)
                                                    {
                                                        <div>
                                                            <span class="text-muted text-decoration-line-through me-2">
                                                                @item.Price.ToString("N0") ₫
                                                            </span>

                                                            <span class="text-primary fs-5 fw-bold">
                                                                @item.FinalPrice.ToString("N0") ₫
                                                            </span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-primary fs-5">
                                                            @item.Price.ToString("N0") ₫
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </a>
                                        <div class="product-item-add border border-top-0 rounded-bottom text-center p-4 pt-0">
                                            <a asp-controller="Product"
                                               asp-action="Detail"
                                               asp-route-id="@item.Id" class="btn btn-primary border-secondary rounded-pill py-2 px-4 mb-4"><i class="fas fa-shopping-cart me-2"></i> Add To Cart</a>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center">

                                                    @{
                                                        var fullStar = (int)Math.Floor(item.AverageRating);
                                                    }

                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= fullStar)
                                                        {
                                                            <i class="fas fa-star text-warning"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="far fa-star text-warning"></i>
                                                        }
                                                    }

                                                    <small class="ms-2 text-muted">
                                                        @item.AverageRating.ToString("0.0")
                                                    </small>

                                                </div>
                                                <div class="d-flex">
                                                    <a href="#" class="text-primary d-flex align-items-center justify-content-center me-3"><span class="rounded-circle btn-sm-square border"><i class="fas fa-random"></i></span></a>
                                                    @* <a href="#" class="text-primary d-flex align-items-center justify-content-center me-0"><span class="rounded-circle btn-sm-square border" data-product-id="@item.Id"><i class="fas fa-heart"></i></span></a> *@
                                                    <a href="#" class="wishlist-btn" data-product-id="@item.Id">
                                                        <span class="rounded-circle btn-sm-square border">
                                                            <i class="fas fa-heart text-danger"></i>
                                                        </span>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    document.querySelectorAll('.wishlist-btn').forEach(btn => {
        btn.addEventListener('click', async function (e) {
            e.preventDefault();

            const productId = this.dataset.productId;
            const icon = this.querySelector('i');

            const res = await fetch('/Product/AddToWishlist', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ productId })
            });

            if (res.status === 401) {
                window.location.href = '/Account/Login';
                return;
            }

            const data = await res.json();

            if (data.isAdded) {
                icon.classList.remove('text-dark');
                icon.classList.add('text-danger');
            } else {
                icon.classList.remove('text-danger');
                icon.classList.add('text-dark');
            }
        });
    });
</script>