@using Data.DTO.Product
@model Data.DTO.Product.ProductDetailDTO

@{
    var sizeOrder = new List<string> { "XS", "S", "M", "L", "XL", "XXL", "2XL", "3XL", "4XL", "FREESIZE" };

    var sortedSizes = Model.Sizes.OrderBy(s =>
    {
        var index = sizeOrder.IndexOf(s.Name.ToUpper());
        return index == -1 ? 999 : index;
    }).ThenBy(s => s.Name).ToList();
}
@section Styles {
    <link rel="stylesheet" href="~/css/user/productdetail.css" />
}
<body>
    <div class="container py-5">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="~/Home/Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="~/Product/Index">Cửa hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết sản phẩm</li>
            </ol>
        </nav>

        <div class="row g-5">
            <div class="col-lg-6">
                <div class="product-image-container mb-3 text-center" id="imgContainer">
                    <img id="mainImage"
                         src="@Model.Images.FirstOrDefault()"
                         class="img-fluid"
                         alt="Product Image" />
                </div>

                <div class="row g-2 justify-content-center">
                    @foreach (var img in Model.Images)
                    {
                        <div class="col-auto">
                            <img src="@img"
                                 class="img-thumbnail thumb-img @(img == Model.Images.First() ? "active" : "")"
                                 style="width: 80px; height: 80px; object-fit: cover;"
                                 onmouseenter="changeImage('@img')"
                                 onclick="changeImage('@img')" />
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <h2 class="product-title mb-3">@Model.Name</h2>

                <div class="d-flex align-items-center mb-3">
                    <div class="star-rating me-3">

                        @{
                            var fullStar = (int)Math.Floor(Model.AverageRating);
                        }

                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= fullStar)
                            {
                                <i class="fas fa-star text-warning"></i>
                            }
                            else
                            {
                                <i class="far fa-star text-warning"></i>
                            }
                        }

                    </div>
                    <span class="text-muted">
                        @Model.AverageRating.ToString("0.0")
                        (@Model.ReviewCount đánh giá)
                    </span>
                </div>

                <h3 class="product-price mb-4">
                    @if (Model.DiscountPercent.HasValue && Model.DiscountPercent > 0)
                    {
                        <span class="text-muted text-decoration-line-through me-2" style="font-size: 1.2rem;">
                            @Model.Price.ToString("N0")đ
                        </span>
                        <span class="text-primary fw-bold">
                            @Model.FinalPrice.ToString("N0")đ
                        </span>
                        <span class="badge bg-danger ms-2" style="font-size: 1rem; vertical-align: middle;">
                            -@Model.DiscountPercent%
                        </span>
                    }
                    else
                    {
                        <span>@Model.Price.ToString("N0")đ</span>
                    }
                </h3>

                <p class="text-muted mb-3">
                    Còn lại:
                    <strong>@Model.AvailableQuantity</strong> sản phẩm
                </p>

                <div class="mb-3">
                    <div class="fw-bold mb-2">Màu sắc:</div>
                    <div class="option-group">
                        @foreach (var c in Model.Colors)
                        {
                            <label class="option-item">
                                <input type="radio" name="color" value="@c.Id" hidden @(Model.Colors.Count == 1 ? "checked" : "")>
                                <span>@c.Name</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <div class="fw-bold mb-2">Kích thước:</div>
                    <div class="option-group">
                        @foreach (var s in sortedSizes)
                        {
                            <label class="option-item">
                                <input type="radio" name="size" value="@s.Id" hidden @(sortedSizes.Count == 1 ? "checked" : "")>
                                <span>@s.Name</span>
                            </label>
                        }
                    </div>
                </div>

                <ul class="list-unstyled mb-4">
                    <li class="feature-item mb-2"><i class="fas fa-check-circle"></i> Uy tín 100%</li>
                    <li class="feature-item mb-2"><i class="fas fa-truck"></i> Giao hàng nhanh chóng</li>
                    <li class="feature-item mb-2"><i class="fas fa-undo"></i> Đổi trả miễn phí nếu có sự cố</li>
                </ul>

                <div class="d-flex align-items-center mb-4 flex-wrap gap-3">
                    <div class="input-group" style="width: 140px;">
                        <button class="btn btn-outline-secondary" type="button" id="btnMinus">-</button>
                        <input type="text" class="form-control text-center fw-bold" id="quantityInput" value="1" readonly>
                        <button class="btn btn-outline-secondary" type="button" id="btnPlus">+</button>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-orange shadow-sm"
                                id="btnAddToCart"
                                data-productid="@Model.Id"
                                @(Model.AvailableQuantity <= 0 ? "disabled" : "")>
                            <i class="fas fa-cart-plus me-2"></i> Thêm vào giỏ
                        </button>

                        <button class="btn btn-orange shadow-sm"
                                id="btnBuyNow"
                                data-productid="@Model.Id"
                                @(Model.AvailableQuantity <= 0 ? "disabled" : "")>
                            <i class="fas fa-bolt me-2"></i> Mua ngay
                        </button>
                    </div>
                </div>

                <div class="border-top pt-3">
                    <p class="mb-0 text-muted">Mã: <strong class="text-dark">@Model.TypeId</strong></p>
                    <p class="mb-0 text-muted">Danh mục: <strong class="text-dark">@Model.TypeName</strong></p>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-12">
                <ul class="nav nav-tabs mb-4" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button">Mô tả chi tiết</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="review-tab" data-bs-toggle="tab" data-bs-target="#review" type="button">Đánh giá (@Model.ReviewCount)</button>
                    </li>
                </ul>
                <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade show active p-3 bg-white rounded shadow-sm" id="desc">
                        <p class="text-muted mb-4">
                            @Html.Raw(Model.Note)
                        </p>
                    </div>
                    <div class="tab-pane fade p-3 bg-white rounded shadow-sm" id="review">
                        @if (Model.Reviews != null && Model.Reviews.Any())
                        {
                            @foreach (var review in Model.Reviews)
                            {
                                <div class="d-flex mb-4 pb-3 border-bottom">

                                    <div class="flex-shrink-0">
                                        <img src="~/uploads/Users/avatar-trang-4.jpg"
                                             class="rounded-circle"
                                             width="50"
                                             height="50"
                                             style="object-fit:cover;">
                                    </div>

                                    <div class="flex-grow-1 ms-3">

                                        <div class="fw-bold mb-1">
                                            @(string.IsNullOrEmpty(review.UserName)
                                                                                ? "Khách hàng"
                                                                                : review.UserName)
                                </div>

                                        <div class="mb-2">

                                    @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="fas fa-star text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-warning"></i>
                                                }
                                            }

                                        </div>

                                        <div class="mb-2">
                                            @review.Comment
                                        </div>
                                        @if (review.Images != null && review.Images.Any())
                                        {
                                            <div class="d-flex gap-2 flex-wrap mt-3">

                                                @foreach (var img in review.Images)
                                                {
                                                    <img src="@img"
                                                         width="90"
                                                         height="90"
                                                         class="rounded border review-image"
                                                         style="object-fit:cover; cursor:pointer;"
                                                         onclick="openReviewImage('@img')">
                                                }

                                            </div>
                                        }

                                        <small class="text-muted">
                                            @review.CreatedDate?.ToString("dd/MM/yyyy HH:mm")
                                        </small>

                                        @if (review.Replies != null &&
                                                                        review.Replies.Any())
                                        {
                                            <div class="mt-3">

                                                @foreach (var reply in review.Replies)
                                                {
                                                    <div class="bg-light rounded p-3 ms-4 border-start border-3 border-dark">

                                                        <div class="d-flex align-items-center mb-2">

                                                            <img src="~/uploads/Users/avatar-trang-4.jpg"
                                                                 class="rounded-circle me-2"
                                                                 width="35"
                                                                 height="35"
                                                                 style="object-fit:cover;" />

                                                            <div>

                                                                <div class="fw-bold">

                                                                    @(string.IsNullOrEmpty(reply.UserName)
                                                                                                                        ? "Shop"
                                                                                                                        : reply.UserName)

                                                </div>

                                                                <small class="text-muted">

                                                                    @reply.CreatedDate?.ToString("dd/MM/yyyy HH:mm")

                                                                </small>

                                                            </div>

                                                        </div>

                                                        <div>

                                                            @reply.Content

                                                        </div>

                                                    </div>
                                                                        }

                                            </div>
                                        }
                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">
                                Chưa có đánh giá nào
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade"
         id="reviewImageModal"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <div class="modal-content bg-transparent border-0">

                <img id="reviewImagePreview"
                     class="img-fluid rounded shadow">

            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function changeImage(src) {
            const main = document.getElementById('mainImage');
            main.src = src;

            document.querySelectorAll('.thumb-img').forEach(img => {
                img.classList.remove('active');
                if (img.getAttribute('src') === src) {
                    img.classList.add('active');
                }
            });
        }

        const imgContainer = document.getElementById('imgContainer');
        const mainImg = document.getElementById('mainImage');

        imgContainer.addEventListener("mousemove", (e) => {
            const rect = imgContainer.getBoundingClientRect();

            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;

            mainImg.style.transformOrigin = `${x}% ${y}%`;
            mainImg.style.transform = "scale(2)";
        });

        imgContainer.addEventListener("mouseleave", () => {
            mainImg.style.transformOrigin = "center center";
            mainImg.style.transform = "scale(1)";
        });
        const qtyInput = document.getElementById('quantityInput');
        async function getRealtimeStock() {

            const productId =
                document.getElementById('btnAddToCart')
                    .dataset.productid;

            const response =
                await fetch(`/Product/GetAvailableStock?productId=${productId}`);

            const data = await response.json();

            return data.stock;
        }
        document.getElementById('btnMinus').addEventListener('click', () => {
            let v = parseInt(qtyInput.value);
            if (v > 1) qtyInput.value = v - 1;
        });

        document.getElementById('btnPlus')
            .addEventListener('click', async () => {

            let v = parseInt(qtyInput.value);

            const stockQuantity =
                await getRealtimeStock();

            if ((v + 1) > stockQuantity) {

                alert(`⚠️ Chỉ còn ${stockQuantity} sản phẩm khả dụng`);

                return;
            }

            qtyInput.value = v + 1;
        });

        async function processCartAction(button, actionType) {

        const productId = button.dataset.productid;

        const stockQuantity = await getRealtimeStock();

        const quantity =
            parseInt(document.getElementById('quantityInput').value);

        if (stockQuantity <= 0) {

            alert("⚠️ Sản phẩm hiện đã hết hàng");

            return;
        }

        if (quantity > stockQuantity) {

            alert(`⚠️ Chỉ còn ${stockQuantity} sản phẩm khả dụng`);

            return;
        }

            const color =
                document.querySelector('input[name="color"]:checked');

            const size =
                document.querySelector('input[name="size"]:checked');

            if (!color || !size) {

                alert("⚠️ Vui lòng chọn đầy đủ MÀU SẮC và KÍCH THƯỚC trước khi đặt hàng!");

                return;
            }

            const originalText = button.innerHTML;

            button.innerHTML =
                '<i class="fas fa-spinner fa-spin me-2"></i> Đang xử lý...';

            button.disabled = true;

            let isBuyNow =
                (actionType === 'checkout') ? "true" : "false";

            fetch('/Cart/AddToCart', {

                method: 'POST',

                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },

                body:
                    `productId=${productId}&colorId=${color.value}&sizeId=${size.value}&quantity=${quantity}&isBuyNow=${isBuyNow}`
            })
            .then(res => {

                if (res.ok) {

                    if (actionType === 'cart') {

                        alert("🛒 Đã thêm sản phẩm vào giỏ hàng!");

                        button.innerHTML = originalText;
                        button.disabled = false;

                    }
                    else if (actionType === 'checkout') {

                        const selectedKey =
                            `${productId}-${color.value}-${size.value}`;

                        window.location.href =
                            `/CheckOut/Index?SelectedItems=${selectedKey}`;
                    }

                }
                else {

                    alert("⚠️ Có lỗi xảy ra, không thể thêm vào giỏ hàng");

                    button.innerHTML = originalText;
                    button.disabled = false;
                }
            })
            .catch(err => {

                alert("⚠️ Lỗi kết nối mạng");

                button.innerHTML = originalText;
                button.disabled = false;
            });
        }

        document.getElementById('btnAddToCart').addEventListener('click', function () {
            processCartAction(this, 'cart');
        });

        document.getElementById('btnBuyNow').addEventListener('click', function () {
            processCartAction(this, 'checkout');
        });


                function openReviewImage(src) {

            $('#reviewImagePreview').attr('src', src);

            $('#reviewImageModal').modal('show');
        }
    </script>
</body>