@using Data.DTO
@using Data.DTO.Product
@model IEnumerable<ProductListDTO>
@{
    var categories = ViewBag.Categories as List<CategoryDTO>;
    var colors = ViewBag.Colors as List<CategoryDTO>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/user/product.css" />
}

<div class="container-fluid shop py-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-lg-3">
                <div class="product-categories mb-5">
                    <h4 class="shop-sidebar-title">Danh mục</h4>
                    <button id="resetFilters" type="button" class="btn btn-outline-danger btn-sm w-100 rounded-pill mb-4 shadow-sm">
                        <i class="fas fa-undo me-1"></i> Làm mới bộ lọc
                    </button>
                    <ul class="list-unstyled">
                        @foreach (var item in categories)
                        {
                            <li>
                                <div class="categories-item d-flex justify-content-between align-items-center category-filter"
                                     data-typeid="@item.Id"
                                     style="cursor:pointer;">

                                    <span class="text-dark">
                                        <i class="fas fa-circle text-primary me-2"
                                           style="font-size: 6px; vertical-align: middle;"></i>

                                        @item.Name
                                    </span>

                                    <span class="badge rounded-pill bg-light text-dark">
                                        @item.ProductCount
                                    </span>

                                </div>
                            </li>
                        }
                    </ul>
                </div>

                <div class="price mb-5">
                    <h4 class="shop-sidebar-title">Khoảng giá</h4>
                    <input type="range" class="form-range w-100" id="rangeInput" name="rangeInput" min="0" max="3000000" step="50000" value="0">
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-muted small">0 đ</span>
                        <output id="amount" class="fw-bold text-primary fs-5">0 đ</output>
                        <span class="text-muted small">3.000.000 đ</span>
                    </div>
                </div>

                <div class="product-color mb-3">
                    <h4 class="shop-sidebar-title">Màu sắc</h4>

                    @if (colors.Count > 10)
                    {
                        <div class="mb-3 px-2">
                            <div class="input-group input-group-sm border rounded-pill overflow-hidden bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fas fa-search fa-xs text-muted"></i></span>
                                <input type="text" id="colorSearch" class="form-control border-0 bg-transparent" placeholder="Tìm nhanh màu..." style="font-size: 0.8rem;">
                            </div>
                        </div>
                    }

                    <div class="px-2 color-list-container" style="max-height: 250px; overflow-y: auto; overflow-x: hidden;">
                        @foreach (var color in colors)
                        {
                            <div class="categories-item d-flex align-items-center justify-content-between color-filter-item">
                                <div class="d-flex align-items-center">
                                    <input type="checkbox"
                                           id="color-@color.Id"
                                           class="color-filter color-filter-checkbox me-2"
                                           value="@color.Id" />
                                    <label for="color-@color.Id" class="text-dark mb-0 cursor-pointer color-name-text">@color.Name</label>
                                </div>
                                <span class="small">(@color.ProductCount)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="shop-toolbar">
                    <div class="row g-4 align-items-center">
                        <div class="col-xl-6 col-lg-12">
                            <div class="input-group modern-search-group">
                                <input type="search" id="searchKeyword" class="form-control" placeholder="Bạn muốn tìm gì hôm nay?">
                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                            </div>
                        </div>

                        <div class="col-xl-4 col-7">
                            <div class="d-flex align-items-center justify-content-end bg-light px-3 py-1 rounded-pill">
                                <label class="text-muted me-2 mb-0 small text-nowrap">Ưu tiên:</label>
                                <select id="sortSelect" class="form-select form-select-sm border-0 bg-transparent shadow-none" style="cursor:pointer; font-weight:600;">
                                    <option value="">Mặc định</option>
                                    <option value="newest">Mới cập nhật</option>
                                    <option value="price_asc">Giá tăng dần</option>
                                    <option value="price_desc">Giá giảm dần</option>
                                    <option value="name_asc">Tên A-Z</option>
                                    <option value="name_desc">Tên Z-A</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-xl-2 col-5 text-end">
                            <div class="view-mode-switcher nav nav-pills shadow-sm">
                                <a class="nav-link active" data-bs-toggle="pill" href="#tab-5" id="gridTrigger">
                                    <i class="fas fa-th-large"></i>
                                </a>
                                <a class="nav-link" data-bs-toggle="pill" href="#tab-6" id="listTrigger">
                                    <i class="fas fa-list-ul"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="active-filters" class="mb-4 d-flex flex-wrap gap-2">
                </div>

                <div id="product-container" style="transition: all 0.4s ease;">
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let page = 1;
        let pageSize = 8;

        let typeId = null;
        let maxPrice = null;
        let keyword = '';
        let sort = '';
        let colorIds = [];

        let viewMode = "grid";

        let priceTimer;
        let searchTimer;

        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);

            if (urlParams.has('typeId')) {
                typeId = parseInt(urlParams.get('typeId'));
            }

            if (urlParams.has('keyword')) {
                keyword = urlParams.get('keyword');
                $('#searchKeyword').val(keyword);
            }

            renderActiveFilters();

            loadProducts();
        });


        function loadProducts() {

            $('#product-container').css("opacity", "0.4");

            $.ajax({
                url: '/Product/LoadProducts',
                type: 'GET',
                data: {
                    page: page,
                    pageSize: pageSize,
                    typeId: typeId,
                    maxPrice: maxPrice,
                    keyword: keyword,
                    sort: sort,
                    colorIds: colorIds
                },
                traditional: true,
                success: function (html) {

                    $('#product-container').html(html);

                    $('#product-container').css("opacity", "1");

                    if (viewMode === "list") {
                        $('#tab-5').removeClass('show active');
                        $('#tab-6').addClass('show active');
                        $('.nav-pills a[href="#tab-6"]').addClass('active');
                        $('.nav-pills a[href="#tab-5"]').removeClass('active');
                    } else {
                        $('#tab-6').removeClass('show active');
                        $('#tab-5').addClass('show active');
                        $('.nav-pills a[href="#tab-5"]').addClass('active');
                        $('.nav-pills a[href="#tab-6"]').removeClass('active');
                    }
                }
            });

        }


        $(document).on('click', '.page-link', function (e) {

            e.preventDefault();

            page = $(this).data('page');

            loadProducts();

            $('html, body').animate({
                scrollTop: $("#product-container").offset().top - 120
            }, 300);

        });



        $('.nav-pills a').on('shown.bs.tab', function (e) {

            let target = $(e.target).attr("href");

            if (target === "#tab-5") viewMode = "grid";

            if (target === "#tab-6") viewMode = "list";

        });



        $('.category-filter').click(function (e) {

            e.preventDefault();

            typeId = $(this).data('typeid');

            page = 1;

            renderActiveFilters();

            loadProducts();

        });



        $('#rangeInput').on('input', function () {

            clearTimeout(priceTimer);

            maxPrice = parseInt(this.value);

            $('#amount').text(maxPrice.toLocaleString() + " đ");

            priceTimer = setTimeout(function () {

                page = 1;

                renderActiveFilters();

                loadProducts();

            }, 300);

        });



        $('#searchKeyword').on('keyup', function () {

            clearTimeout(searchTimer);

            searchTimer = setTimeout(function () {

                keyword = $('#searchKeyword').val();

                page = 1;

                renderActiveFilters();

                loadProducts();

            }, 400);

        });



        $('#sortSelect').change(function () {

            sort = $(this).val();

            page = 1;

            renderActiveFilters();

            loadProducts();

        });


        $(document).on('change', '.color-filter', function () {

            colorIds = $('.color-filter:checked')
                .map(function () {
                    return parseInt($(this).val());
                })
                .get();

            page = 1;

            renderActiveFilters();

            loadProducts();

        });


        $('#resetFilters').click(function () {

            page = 1;
            typeId = null;
            maxPrice = null;
            keyword = '';
            sort = '';
            colorIds = [];

            $('#searchKeyword').val('');
            $('#sortSelect').val('');
            $('#rangeInput').val(0);
            $('#amount').text('0 đ');
            $('.color-filter').prop('checked', false);

            renderActiveFilters();

            loadProducts();

        });


        function renderActiveFilters() {

            let html = '';

            if (typeId) {

                    let name = $('.category-filter[data-typeid="' + typeId + '"]')
                            .find('.text-dark')
                            .first()
                            .contents()
                            .filter(function () {
                                return this.nodeType === 3;
                            })
                            .text()
                            .trim();

                html += filterTag('Danh mục', name, 'type');

            }

            colorIds.forEach(function (id) {

                let name = $('label[for="color-' + id + '"]').text().trim();

                html += filterTag('Màu', name, 'color', id);

            });

            if (maxPrice && maxPrice > 0) {

                html += filterTag('Giá ≤', maxPrice.toLocaleString() + ' đ', 'price');

            }

            if (keyword) {

                html += filterTag('Từ khóa', keyword, 'keyword');

            }

            $('#active-filters').html(html);

        }


        function filterTag(label, value, type, id = null) {

            return `
                <span class="badge bg-secondary d-flex align-items-center">
                    ${label}: ${value}
                    <i class="fas fa-times ms-2 remove-filter"
                       data-type="${type}"
                       data-id="${id}"
                       style="cursor:pointer"></i>
                </span>
            `;

        }


        $(document).on('click', '.remove-filter', function () {

            let type = $(this).data('type');
            let id = $(this).data('id');

            switch (type) {

                case 'type':
                    typeId = null;
                    break;

                case 'color':
                    colorIds = colorIds.filter(function (x) {
                        return x !== id;
                    });

                    $('#color-' + id).prop('checked', false);
                    break;

                case 'price':
                    maxPrice = null;
                    $('#rangeInput').val(0);
                    $('#amount').text('0 đ');
                    break;

                case 'keyword':
                    keyword = '';
                    $('#searchKeyword').val('');
                    break;
            }

            page = 1;

            renderActiveFilters();

            loadProducts();

        });

                $('#colorSearch').on('keyup', function() {
            let value = $(this).val().toLowerCase().trim();
            $(".color-filter-item").filter(function() {
                $(this).toggle($(this).find(".color-name-text").text().toLowerCase().indexOf(value) > -1)
            });
        });
    </script>
}
