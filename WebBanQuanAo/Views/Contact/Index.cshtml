@model Data.DTO.Contact.ContactViewModel

@{
    ViewData["Title"] = "Liên hệ";
}

<div class="container-fluid py-5">

    <div class="container py-5">

        <!-- TITLE -->

        <div class="text-center mb-5">

            <h1 class="display-4 fw-bold text-dark">
                LIÊN HỆ VYBE
            </h1>

            <p class="text-muted fs-5">
                Chúng tôi luôn sẵn sàng hỗ trợ bạn
            </p>

        </div>

        <!-- SUCCESS -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success text-center rounded-pill shadow-sm mb-5">
                @TempData["Success"]
            </div>
        }

        <div class="row g-5">

            <!-- FORM -->

            <div class="col-lg-7">

                <div class="bg-light rounded-4 p-5 shadow-sm h-100">

                    <h3 class="fw-bold mb-4">
                        Gửi email cho VYBE
                    </h3>

                    <form asp-action="Send" method="post">

                        <div class="row g-4">

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Họ và tên
                                </label>

                                <input asp-for="FullName"
                                       class="form-control py-3 rounded-3"
                                       placeholder="Nhập họ tên" />

                                <span asp-validation-for="FullName"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       class="form-control py-3 rounded-3"
                                       placeholder="Nhập email" />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Số điện thoại
                                </label>

                                <input asp-for="Phone"
                                       class="form-control py-3 rounded-3"
                                       placeholder="Nhập số điện thoại" />

                            </div>

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Chủ đề
                                </label>

                                <input asp-for="Subject"
                                       class="form-control py-3 rounded-3"
                                       placeholder="Ví dụ: Hỗ trợ đơn hàng" />

                                <span asp-validation-for="Subject"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Nội dung
                                </label>

                                <textarea asp-for="Message"
                                          rows="7"
                                          class="form-control rounded-3"
                                          placeholder="Nhập nội dung liên hệ"></textarea>

                                <span asp-validation-for="Message"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-12">

                                <button type="submit"
                                        class="btn btn-dark rounded-pill py-3 w-100 fw-semibold">

                                    Gửi liên hệ

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

            <!-- INFO -->

            <div class="col-lg-5">

                <div class="bg-white rounded-4 p-5 shadow-sm h-100 border">

                    <h3 class="fw-bold mb-4">
                        VYBE
                    </h3>

                    <div class="mb-4">

                        <div class="d-flex align-items-center mb-2">

                            <i class="fas fa-map-marker-alt me-3 text-primary"></i>

                            <h6 class="mb-0">
                                Địa chỉ
                            </h6>

                        </div>

                        <p class="text-muted ms-4 mb-0">
                            Hà Nội, Việt Nam
                        </p>

                    </div>

                    <div class="mb-4">

                        <div class="d-flex align-items-center mb-2">

                            <i class="fas fa-envelope me-3 text-primary"></i>

                            <h6 class="mb-0">
                                Email
                            </h6>

                        </div>

                        <p class="text-muted ms-4 mb-0">
                            vybesupportvn@gmail.com
                        </p>

                    </div>

                    <div class="mb-4">

                        <div class="d-flex align-items-center mb-2">

                            <i class="fas fa-phone-alt me-3 text-primary"></i>

                            <h6 class="mb-0">
                                Hotline
                            </h6>

                        </div>

                        <p class="text-muted ms-4 mb-0">
                            (+84) 372 783 688
                        </p>

                    </div>

                    <div class="mb-4">

                        <div class="d-flex align-items-center mb-2">

                            <i class="fas fa-clock me-3 text-primary"></i>

                            <h6 class="mb-0">
                                Giờ hoạt động
                            </h6>

                        </div>

                        <p class="text-muted ms-4 mb-0">
                            08:00 - 22:00
                        </p>

                    </div>

                    <hr class="border-secondary my-4">

                    <h5 class="fw-bold mb-3">
                        Theo dõi VYBE
                    </h5>

                    <div class="d-flex gap-3">

                        <a href="#"
                           class="btn btn-outline-dark rounded-circle">

                            <i class="fab fa-facebook-f"></i>

                        </a>

                        <a href="#"
                           class="btn btn-outline-dark rounded-circle">

                            <i class="fab fa-instagram"></i>

                        </a>

                        <a href="#"
                           class="btn btn-outline-dark rounded-circle">

                            <i class="fab fa-tiktok"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- MAP -->

        <div class="mt-5 rounded-4 overflow-hidden shadow-sm">

            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3723.4736632131003!2d105.7325318759702!3d21.05373598691888!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31345457e292d5bf%3A0x20ac91c94d74439a!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBDw7RuZyBuZ2hp4buHcCBIw6AgTuG7mWk!5e0!3m2!1svi!2s!4v1773222059957!5m2!1svi!2s"
                    width="100%"
                    height="450"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy">
            </iframe>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}